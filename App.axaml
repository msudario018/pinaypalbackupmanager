<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:PinayPalBackupManager.UI.Converters"
             x:Class="PinayPalBackupManager.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />

        <!-- GLASSMORPHISM STYLES -->
        <!-- Modern Glass Panel Style -->
        <Style Selector="Border.glass-panel">
            <Setter Property="Background" Value="#0A000000"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Opacity" Value="0.85"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.3"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Glass Panel with Blur Effect -->
        <Style Selector="Border.glass-panel-blur">
            <Setter Property="Background" Value="#0F000000"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.3"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Modern Sidebar Glass Style -->
        <Style Selector="Border.glass-sidebar">
            <Setter Property="Background" Value="#0D000000"/>
            <Setter Property="BorderBrush" Value="#15FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Opacity" Value="0.92"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.3"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Modern Top Bar Glass Style -->
        <Style Selector="Border.glass-topbar">
            <Setter Property="Background" Value="#0A000000"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Opacity" Value="0.88"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.3"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Modern Status Bar Glass Style -->
        <Style Selector="Border.glass-statusbar">
            <Setter Property="Background" Value="#0C000000"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.3"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Enhanced Drop Shadow for Glass -->
        <Style Selector="Border.glass-shadow">
            <Setter Property="BoxShadow" Value="0 4 20 #20000000"/>
        </Style>

        <!-- Modern Button Glass Style -->
        <Style Selector="Button.glass-btn">
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.glass-btn:pointerover">
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="Opacity" Value="0.95"/>
            <Setter Property="RenderTransform" Value="scale(1.02) translateY(-1px)"/>
        </Style>

        <Style Selector="Button.glass-btn:pressed">
            <Setter Property="Background" Value="#08FFFFFF"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>

        <!-- GLOBAL ANIMATIONS & TRANSITIONS -->
        <!-- Global Button Animations - Optimized for faster theme switching -->
        <Style Selector="Button">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.08"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Sidebar Button Animations - Optimized -->
        <Style Selector="Button.SideBtn">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.SideBtn:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.08) translateY(-1px)"/>
        </Style>
        <Style Selector="Button.SideBtn:pressed">
            <Setter Property="RenderTransform" Value="scale(0.95)"/>
        </Style>
        <Style Selector="Button.SideBtn.Selected">
            <Setter Property="RenderTransform" Value="scale(1.0)"/>
        </Style>

        <!-- Border Animations - Optimized for faster theme switching -->
        <Style Selector="Border">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.08"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.08"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- TextBlock Animations - Optimized -->
        <Style Selector="TextBlock">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.08"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Global Font Styles (Theme Customizer) -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
        </Style>

        <!-- ListBox Item Animations - Optimized -->
        <Style Selector="ListBoxItem">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.08"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.08"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- DataGridRow Animations - Optimized -->
        <Style Selector="DataGridRow">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.08"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.08"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Content Control Fade-in - Optimized -->
        <Style Selector="ContentControl">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Modern Glassmorphism Card Style -->
        <Style Selector="Border.glass">
            <Setter Property="Background" Value="{DynamicResource AppGlass}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BoxShadow" Value="0 4 16 #00000020, 0 8 32 #00000010"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.glass:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppGlassHover}"/>
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>

        <!-- Enhanced Modern Button Styles -->
        <Style Selector="Button.modern">
            <Setter Property="Background" Value="{DynamicResource AppSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.1"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.modern:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="RenderTransform" Value="scale(1.05) translateY(-2px)"/>
        </Style>
        <Style Selector="Button.modern:pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>

        <!-- Floating Action Button Style -->
        <Style Selector="Button.fab">
            <Setter Property="Background" Value="{DynamicResource AccentWebsite}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="50"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.fab:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.1) translateY(-4px)"/>
            <Setter Property="Background" Value="{DynamicResource AccentWebsiteLight}"/>
        </Style>

        <!-- Modern ProgressBar with glow -->
        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource AppBorder}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Value" Duration="0:0:0.25"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.Primary">
            <Setter Property="Background" Value="{DynamicResource AccentWebsite}"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,10"/>
        </Style>

        <Style Selector="Button.Primary.Ftp">
            <Setter Property="Background" Value="{DynamicResource AccentFtp}"/>
            <Setter Property="Foreground" Value="#000000"/>
        </Style>
        <Style Selector="Button.Primary.Mailchimp">
            <Setter Property="Background" Value="{DynamicResource AccentMailchimp}"/>
            <Setter Property="Foreground" Value="#000000"/>
        </Style>
        <Style Selector="Button.Primary.Sql">
            <Setter Property="Background" Value="{DynamicResource AccentSql}"/>
            <Setter Property="Foreground" Value="#000000"/>
        </Style>
        <Style Selector="Button.Primary.Settings">
            <Setter Property="Background" Value="{DynamicResource AccentWebsite}"/>
            <Setter Property="Foreground" Value="#000000"/>
        </Style>
        <Style Selector="Button.Primary.Website">
            <Setter Property="Background" Value="{DynamicResource AccentWebsite}"/>
            <Setter Property="Foreground" Value="#000000"/>
        </Style>
        <Style Selector="Button.Primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentWebsiteLight}"/>
            <Setter Property="RenderTransform" Value="scale(1.03)"/>
        </Style>
        <Style Selector="Button.Primary:pressed">
            <Setter Property="Background" Value="{DynamicResource AccentWebsiteDark}"/>
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

        <Style Selector="Button.Secondary">
            <Setter Property="Background" Value="{DynamicResource AppBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,9"/>
        </Style>
        <Style Selector="Button.Secondary:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppMuted}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        <Style Selector="Button.Secondary:pressed">
            <Setter Property="Background" Value="{DynamicResource AppSubtext}"/>
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

        <Style Selector="Button.Danger">
            <Setter Property="Background" Value="#0B0F17"/>
            <Setter Property="Foreground" Value="#F38BA8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,9"/>
        </Style>
        <Style Selector="Button.Danger:pointerover">
            <Setter Property="Background" Value="#FFB3C7"/>
            <Setter Property="Foreground" Value="#0B0F17"/>
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        <Style Selector="Button.Danger:pressed">
            <Setter Property="Background" Value="#E37A92"/>
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

        <!-- Admin Button Style - Uses muted color palette -->
        <Style Selector="Button.Admin">
            <Setter Property="Background" Value="{DynamicResource AppSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.Admin:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFtp}"/>
            <Setter Property="RenderTransform" Value="scale(1.03)"/>
        </Style>
        <Style Selector="Button.Admin:pressed">
            <Setter Property="Background" Value="{DynamicResource AppBorder}"/>
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>

        <Style Selector="Button.Ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style Selector="Button.Ghost:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppCard}"/>
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        <Style Selector="Button.Ghost:pressed">
            <Setter Property="Background" Value="{DynamicResource AppBorder}"/>
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <!-- Modern Dark Theme — Deep Space -->
                    <SolidColorBrush x:Key="AppBg">#02040A</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSidebar">#0A0F1C</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTopBar">#0C1322</SolidColorBrush>
                    <SolidColorBrush x:Key="AppCard">#111827</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSurface">#1A2332</SolidColorBrush>
                    <SolidColorBrush x:Key="AppText">#F1F5F9</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSubtext">#94A3B8</SolidColorBrush>
                    <SolidColorBrush x:Key="AppMuted">#64748B</SolidColorBrush>
                    <SolidColorBrush x:Key="AppVeryMuted">#475569</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBorder">#1E293B</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBorder2">#0F172A</SolidColorBrush>

                    <!-- Transparency & Glass Layers -->
                    <SolidColorBrush x:Key="AppGlass">#FFFFFF08</SolidColorBrush>
                    <SolidColorBrush x:Key="AppGlassHover">#FFFFFF12</SolidColorBrush>
                    <SolidColorBrush x:Key="AppShadow">#00000080</SolidColorBrush>
                    <SolidColorBrush x:Key="AppOverlay">#02040ACC</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTimerAutoScan">#052E16</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTimerDaily">#0C1A3C</SolidColorBrush>
                    <SolidColorBrush x:Key="AppManilaTime">#34D399</SolidColorBrush>
                    <SolidColorBrush x:Key="AppLogText">#CBD5E1</SolidColorBrush>
                    <SolidColorBrush x:Key="AppWarning">#FBBF24</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBtnGreen">#064E3B</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBtnBlue">#0C1A3C</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBtnRed">#450A0A</SolidColorBrush>

                    <!-- FTP — Modern Emerald -->
                    <SolidColorBrush x:Key="AccentFtp">#34D399</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpLight">#6EE7B7</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpDark">#059669</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpBg">#064E3B</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpMuted">#10B981</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpSurface">#34D399</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpGlow">#34D39940</SolidColorBrush>

                    <!-- Mailchimp — Modern Sky Blue -->
                    <SolidColorBrush x:Key="AccentMailchimp">#60A5FA</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpLight">#93C5FD</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpDark">#2563EB</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpBg">#0C1A3C</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpMuted">#3B82F6</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpSurface">#60A5FA</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpGlow">#60A5FA40</SolidColorBrush>

                    <!-- SQL — Modern Amber -->
                    <SolidColorBrush x:Key="AccentSql">#FBBF24</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlLight">#FCD34D</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlDark">#D97706</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlBg">#451A03</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlMuted">#F59E0B</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlSurface">#FBBF24</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlGlow">#FBBF2440</SolidColorBrush>

                    <!-- Settings / General — Modern Violet -->
                    <SolidColorBrush x:Key="AccentWebsite">#A78BFA</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteLight">#C4B5FD</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteDark">#7C3AED</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteBg">#2E1065</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteMuted">#8B5CF6</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteSurface">#A78BFA</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteGlow">#A78BFA40</SolidColorBrush>

                    <!-- Error — Modern Rose -->
                    <SolidColorBrush x:Key="AccentError">#FB7185</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorLight">#FDA4AF</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorDark">#E11D48</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorBg">#4C0519</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorMuted">#F43F5E</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorSurface">#FB7185</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorGlow">#FB718540</SolidColorBrush>

                    <!-- Success / Info / Warning aliases -->
                    <SolidColorBrush x:Key="AccentSuccess">#34D399</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentInfo">#60A5FA</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentInfoLight">#93C5FD</SolidColorBrush>

                    <!-- Sidebar -->
                    <SolidColorBrush x:Key="SidebarIconMuted">#64748B</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarIconActive">#F1F5F9</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarSelectedBg">#1E293B</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarDivider">#1E293B</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarGlow">#60A5FA20</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarHover">#FFFFFF0A</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <!-- Modern Light Theme — Clean Slate -->
                    <SolidColorBrush x:Key="AppBg">#F8FAFC</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSidebar">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTopBar">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="AppCard">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSurface">#F1F5F9</SolidColorBrush>
                    <SolidColorBrush x:Key="AppText">#0F172A</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSubtext">#475569</SolidColorBrush>
                    <SolidColorBrush x:Key="AppMuted">#94A3B8</SolidColorBrush>
                    <SolidColorBrush x:Key="AppVeryMuted">#CBD5E1</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBorder">#E2E8F0</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBorder2">#F1F5F9</SolidColorBrush>

                    <!-- Light Glass Layers -->
                    <SolidColorBrush x:Key="AppGlass">#00000005</SolidColorBrush>
                    <SolidColorBrush x:Key="AppGlassHover">#0000000A</SolidColorBrush>
                    <SolidColorBrush x:Key="AppShadow">#00000020</SolidColorBrush>
                    <SolidColorBrush x:Key="AppOverlay">#F8FAFCDD</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTimerAutoScan">#ECFDF5</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTimerDaily">#EFF6FF</SolidColorBrush>
                    <SolidColorBrush x:Key="AppManilaTime">#059669</SolidColorBrush>
                    <SolidColorBrush x:Key="AppLogText">#0F172A</SolidColorBrush>
                    <SolidColorBrush x:Key="AppWarning">#92400E</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBtnGreen">#D1FAE5</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBtnBlue">#DBEAFE</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBtnRed">#FEE2E2</SolidColorBrush>

                    <!-- FTP — Modern Emerald -->
                    <SolidColorBrush x:Key="AccentFtp">#059669</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpLight">#10B981</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpDark">#047857</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpBg">#D1FAE5</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpMuted">#34D399</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpSurface">#059669</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpGlow">#05966925</SolidColorBrush>

                    <!-- Mailchimp — Modern Sky Blue -->
                    <SolidColorBrush x:Key="AccentMailchimp">#2563EB</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpLight">#3B82F6</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpDark">#1D4ED8</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpBg">#DBEAFE</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpMuted">#60A5FA</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpSurface">#2563EB</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpGlow">#2563EB25</SolidColorBrush>

                    <!-- SQL — Modern Amber -->
                    <SolidColorBrush x:Key="AccentSql">#D97706</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlLight">#F59E0B</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlDark">#B45309</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlBg">#FEF3C7</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlMuted">#FBBF24</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlSurface">#D97706</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlGlow">#D9770625</SolidColorBrush>

                    <!-- Website — Modern Violet -->
                    <SolidColorBrush x:Key="AccentWebsite">#7C3AED</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteLight">#8B5CF6</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteDark">#6D28D9</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteBg">#EDE9FE</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteMuted">#A78BFA</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteSurface">#7C3AED</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteGlow">#7C3AED25</SolidColorBrush>

                    <!-- Error — Modern Rose -->
                    <SolidColorBrush x:Key="AccentError">#E11D48</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorLight">#FB7185</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorDark">#BE123C</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorBg">#FFE4E6</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorMuted">#F43F5E</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorSurface">#E11D48</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorGlow">#E11D4825</SolidColorBrush>

                    <!-- Success / Info / Warning aliases -->
                    <SolidColorBrush x:Key="AccentSuccess">#059669</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentInfo">#2563EB</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentInfoLight">#3B82F6</SolidColorBrush>

                    <!-- Sidebar -->
                    <SolidColorBrush x:Key="SidebarIconMuted">#94A3B8</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarIconActive">#0F172A</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarSelectedBg">#F1F5F9</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarDivider">#E2E8F0</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarGlow">#2563EB12</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarHover">#00000005</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Color x:Key="ColorBg">#02040A</Color>
            <Color x:Key="ColorSurface">#1A2332</Color>
            <Color x:Key="ColorSurface2">#111827</Color>
            <Color x:Key="ColorBorder">#1E293B</Color>
            <Color x:Key="ColorText">#F1F5F9</Color>
            <Color x:Key="ColorMuted">#94A3B8</Color>
            <Color x:Key="ColorAccentFtp">#34D399</Color>
            <Color x:Key="ColorAccentMailchimp">#60A5FA</Color>
            <Color x:Key="ColorAccentSql">#FBBF24</Color>
            <Color x:Key="ColorAccentWebsite">#A78BFA</Color>
            <cv:BoolToStatusTextConverter x:Key="BoolToStatusText" />
            <cv:BoolToStatusBrushConverter x:Key="BoolToStatusBrush" />

            <!-- Default Font Resources -->
            <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
            <x:Double x:Key="AppFontSize">14</x:Double>
            <FontWeight x:Key="AppFontWeight">Normal</FontWeight>
        </ResourceDictionary>
    </Application.Resources>
</Application>
