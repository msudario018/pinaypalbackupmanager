<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:PinayPalBackupManager.UI.Converters"
             x:Class="PinayPalBackupManager.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />

        <!-- GLASSMORPHISM STYLES -->
        <!-- Modern Glass Panel Style -->
        <Style Selector="Border.glass-panel">
            <Setter Property="Background" Value="#0A000000"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Opacity" Value="0.85"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.3"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Glass Panel with Blur Effect -->
        <Style Selector="Border.glass-panel-blur">
            <Setter Property="Background" Value="#0F000000"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.3"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Modern Sidebar Glass Style -->
        <Style Selector="Border.glass-sidebar">
            <Setter Property="Background" Value="#0D000000"/>
            <Setter Property="BorderBrush" Value="#15FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Opacity" Value="0.92"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.3"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Modern Top Bar Glass Style -->
        <Style Selector="Border.glass-topbar">
            <Setter Property="Background" Value="#0A000000"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Opacity" Value="0.88"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.3"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Modern Status Bar Glass Style -->
        <Style Selector="Border.glass-statusbar">
            <Setter Property="Background" Value="#0C000000"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.3"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Enhanced Drop Shadow for Glass -->
        <Style Selector="Border.glass-shadow">
            <Setter Property="BoxShadow" Value="0 4 20 #20000000"/>
        </Style>

        <!-- Modern Button Glass Style -->
        <Style Selector="Button.glass-btn">
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.glass-btn:pointerover">
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="Opacity" Value="0.95"/>
            <Setter Property="RenderTransform" Value="scale(1.02) translateY(-1px)"/>
        </Style>

        <Style Selector="Button.glass-btn:pressed">
            <Setter Property="Background" Value="#08FFFFFF"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>

        <!-- GLOBAL ANIMATIONS & TRANSITIONS -->
        <!-- Global Button Animations - Optimized for faster theme switching -->
        <Style Selector="Button">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.08"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Sidebar Button Animations - Optimized -->
        <Style Selector="Button.SideBtn">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.SideBtn:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.08) translateY(-1px)"/>
        </Style>
        <Style Selector="Button.SideBtn:pressed">
            <Setter Property="RenderTransform" Value="scale(0.95)"/>
        </Style>
        <Style Selector="Button.SideBtn.Selected">
            <Setter Property="RenderTransform" Value="scale(1.0)"/>
        </Style>

        <!-- Border Animations - Optimized for faster theme switching -->
        <Style Selector="Border">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.08"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.08"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- TextBlock Animations - Optimized -->
        <Style Selector="TextBlock">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.08"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- ListBox Item Animations - Optimized -->
        <Style Selector="ListBoxItem">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.08"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.08"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- DataGridRow Animations - Optimized -->
        <Style Selector="DataGridRow">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.08"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.08"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Content Control Fade-in - Optimized -->
        <Style Selector="ContentControl">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Modern Glassmorphism Card Style -->
        <Style Selector="Border.glass">
            <Setter Property="Background" Value="{DynamicResource AppGlass}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BoxShadow" Value="0 4 16 #00000020, 0 8 32 #00000010"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.glass:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppGlassHover}"/>
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>

        <!-- Enhanced Modern Button Styles -->
        <Style Selector="Button.modern">
            <Setter Property="Background" Value="{DynamicResource AppSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.1"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.modern:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="RenderTransform" Value="scale(1.05) translateY(-2px)"/>
        </Style>
        <Style Selector="Button.modern:pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>

        <!-- Floating Action Button Style -->
        <Style Selector="Button.fab">
            <Setter Property="Background" Value="{DynamicResource AccentWebsite}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="50"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.fab:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.1) translateY(-4px)"/>
            <Setter Property="Background" Value="{DynamicResource AccentWebsiteLight}"/>
        </Style>

        <!-- ProgressBar smooth value transition and style - Optimized -->
        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="{DynamicResource AppBorder}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Value" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.Primary">
            <Setter Property="Background" Value="{DynamicResource AccentWebsite}"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,10"/>
        </Style>

        <Style Selector="Button.Primary.Ftp">
            <Setter Property="Background" Value="{DynamicResource AccentFtp}"/>
            <Setter Property="Foreground" Value="#000000"/>
        </Style>
        <Style Selector="Button.Primary.Mailchimp">
            <Setter Property="Background" Value="{DynamicResource AccentMailchimp}"/>
            <Setter Property="Foreground" Value="#000000"/>
        </Style>
        <Style Selector="Button.Primary.Sql">
            <Setter Property="Background" Value="{DynamicResource AccentSql}"/>
            <Setter Property="Foreground" Value="#000000"/>
        </Style>
        <Style Selector="Button.Primary.Settings">
            <Setter Property="Background" Value="{DynamicResource AccentWebsite}"/>
            <Setter Property="Foreground" Value="#000000"/>
        </Style>
        <Style Selector="Button.Primary.Website">
            <Setter Property="Background" Value="{DynamicResource AccentWebsite}"/>
            <Setter Property="Foreground" Value="#000000"/>
        </Style>
        <Style Selector="Button.Primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentWebsiteLight}"/>
            <Setter Property="RenderTransform" Value="scale(1.03)"/>
        </Style>
        <Style Selector="Button.Primary:pressed">
            <Setter Property="Background" Value="{DynamicResource AccentWebsiteDark}"/>
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

        <Style Selector="Button.Secondary">
            <Setter Property="Background" Value="{DynamicResource AppBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,9"/>
        </Style>
        <Style Selector="Button.Secondary:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppMuted}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        <Style Selector="Button.Secondary:pressed">
            <Setter Property="Background" Value="{DynamicResource AppSubtext}"/>
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

        <Style Selector="Button.Danger">
            <Setter Property="Background" Value="#0B0F17"/>
            <Setter Property="Foreground" Value="#F38BA8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,9"/>
        </Style>
        <Style Selector="Button.Danger:pointerover">
            <Setter Property="Background" Value="#FFB3C7"/>
            <Setter Property="Foreground" Value="#0B0F17"/>
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        <Style Selector="Button.Danger:pressed">
            <Setter Property="Background" Value="#E37A92"/>
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

        <!-- Admin Button Style - Uses muted color palette -->
        <Style Selector="Button.Admin">
            <Setter Property="Background" Value="{DynamicResource AppSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.Admin:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFtp}"/>
            <Setter Property="RenderTransform" Value="scale(1.03)"/>
        </Style>
        <Style Selector="Button.Admin:pressed">
            <Setter Property="Background" Value="{DynamicResource AppBorder}"/>
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>

        <Style Selector="Button.Ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style Selector="Button.Ghost:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppCard}"/>
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        <Style Selector="Button.Ghost:pressed">
            <Setter Property="Background" Value="{DynamicResource AppBorder}"/>
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <!-- Neo-Dark Midnight Theme -->
                    <SolidColorBrush x:Key="AppBg">#06090F</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSidebar">#090D18</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTopBar">#090D18</SolidColorBrush>
                    <SolidColorBrush x:Key="AppCard">#0E1525</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSurface">#162033</SolidColorBrush>
                    <SolidColorBrush x:Key="AppText">#E4EBF8</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSubtext">#8A99B8</SolidColorBrush>
                    <SolidColorBrush x:Key="AppMuted">#576080</SolidColorBrush>
                    <SolidColorBrush x:Key="AppVeryMuted">#374060</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBorder">#1A2540</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBorder2">#0E1525</SolidColorBrush>

                    <!-- Transparency & Glass Layers -->
                    <SolidColorBrush x:Key="AppGlass">#FFFFFF0D</SolidColorBrush>
                    <SolidColorBrush x:Key="AppGlassHover">#FFFFFF18</SolidColorBrush>
                    <SolidColorBrush x:Key="AppShadow">#00000060</SolidColorBrush>
                    <SolidColorBrush x:Key="AppOverlay">#06090F90</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTimerAutoScan">#0A1F14</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTimerDaily">#0C1228</SolidColorBrush>
                    <SolidColorBrush x:Key="AppManilaTime">#00D68C</SolidColorBrush>
                    <SolidColorBrush x:Key="AppLogText">#C8D6EE</SolidColorBrush>
                    <SolidColorBrush x:Key="AppWarning">#F0B429</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBtnGreen">#071C12</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBtnBlue">#071222</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBtnRed">#200A0A</SolidColorBrush>

                    <!-- FTP / Website Backup — Teal-Green -->
                    <SolidColorBrush x:Key="AccentFtp">#00D68C</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpLight">#33FFBE</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpDark">#00A86E</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpBg">#071C12</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpMuted">#00B878</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpSurface">#00D68C</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpGlow">#00D68C35</SolidColorBrush>

                    <!-- Mailchimp — Electric Blue -->
                    <SolidColorBrush x:Key="AccentMailchimp">#3D9CFF</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpLight">#7ABFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpDark">#1A7AE0</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpBg">#061428</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpMuted">#5BADFF</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpSurface">#3D9CFF</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpGlow">#3D9CFF35</SolidColorBrush>

                    <!-- SQL — Warm Gold -->
                    <SolidColorBrush x:Key="AccentSql">#F0B429</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlLight">#FFCD5E</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlDark">#C48E10</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlBg">#1E1500</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlMuted">#D4A030</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlSurface">#F0B429</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlGlow">#F0B42935</SolidColorBrush>

                    <!-- Settings / General — Indigo-Purple -->
                    <SolidColorBrush x:Key="AccentWebsite">#9D7FFF</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteLight">#C5ADFF</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteDark">#7A5CE0</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteBg">#120D2A</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteMuted">#B599FF</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteSurface">#7A5CE0</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteGlow">#9D7FFF35</SolidColorBrush>

                    <!-- Error — Vivid Red -->
                    <SolidColorBrush x:Key="AccentError">#FF5252</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorLight">#FF8A80</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorDark">#D63232</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorBg">#200A0A</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorMuted">#FF7070</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorSurface">#D63232</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorGlow">#FF525235</SolidColorBrush>

                    <!-- Success / Info / Warning aliases -->
                    <SolidColorBrush x:Key="AccentSuccess">#00D68C</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentInfo">#3D9CFF</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentInfoLight">#7ABFFF</SolidColorBrush>

                    <!-- Sidebar -->
                    <SolidColorBrush x:Key="SidebarIconMuted">#576080</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarIconActive">#E4EBF8</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarSelectedBg">#121E35</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarDivider">#1A2540</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarGlow">#3D9CFF20</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarHover">#FFFFFF0C</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <!-- Clean Light Theme -->
                    <SolidColorBrush x:Key="AppBg">#F4F6FC</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSidebar">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTopBar">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="AppCard">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSurface">#EEF1FA</SolidColorBrush>
                    <SolidColorBrush x:Key="AppText">#111827</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSubtext">#4B5568</SolidColorBrush>
                    <SolidColorBrush x:Key="AppMuted">#9CA3AF</SolidColorBrush>
                    <SolidColorBrush x:Key="AppVeryMuted">#6B7280</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBorder">#DEE5F0</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBorder2">#EEF1FA</SolidColorBrush>

                    <!-- Light Glass Layers -->
                    <SolidColorBrush x:Key="AppGlass">#00000005</SolidColorBrush>
                    <SolidColorBrush x:Key="AppGlassHover">#0000000D</SolidColorBrush>
                    <SolidColorBrush x:Key="AppShadow">#00000018</SolidColorBrush>
                    <SolidColorBrush x:Key="AppOverlay">#F4F6FCCC</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTimerAutoScan">#EDFAF4</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTimerDaily">#EFF1FF</SolidColorBrush>
                    <SolidColorBrush x:Key="AppManilaTime">#007A50</SolidColorBrush>
                    <SolidColorBrush x:Key="AppLogText">#111827</SolidColorBrush>
                    <SolidColorBrush x:Key="AppWarning">#B45309</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBtnGreen">#D1FAE5</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBtnBlue">#DBEAFE</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBtnRed">#FEE2E2</SolidColorBrush>

                    <!-- FTP — Green -->
                    <SolidColorBrush x:Key="AccentFtp">#059669</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpLight">#10B981</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpDark">#047857</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpBg">#D1FAE5</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpMuted">#10B981</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpSurface">#059669</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpGlow">#05966930</SolidColorBrush>

                    <!-- Mailchimp — Blue -->
                    <SolidColorBrush x:Key="AccentMailchimp">#2563EB</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpLight">#3B82F6</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpDark">#1D4ED8</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpBg">#DBEAFE</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpMuted">#3B82F6</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpSurface">#2563EB</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpGlow">#2563EB30</SolidColorBrush>

                    <!-- SQL — Amber -->
                    <SolidColorBrush x:Key="AccentSql">#D97706</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlLight">#F59E0B</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlDark">#B45309</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlBg">#FEF3C7</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlMuted">#F59E0B</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlSurface">#D97706</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlGlow">#D9770630</SolidColorBrush>

                    <!-- Website — Purple -->
                    <SolidColorBrush x:Key="AccentWebsite">#7C3AED</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteLight">#8B5CF6</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteDark">#6D28D9</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteBg">#EDE9FE</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteMuted">#8B5CF6</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteSurface">#7C3AED</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteGlow">#7C3AED30</SolidColorBrush>

                    <!-- Error — Red -->
                    <SolidColorBrush x:Key="AccentError">#DC2626</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorLight">#EF4444</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorDark">#B91C1C</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorBg">#FEE2E2</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorMuted">#EF4444</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorSurface">#DC2626</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorGlow">#DC262630</SolidColorBrush>

                    <!-- Success / Info / Warning aliases -->
                    <SolidColorBrush x:Key="AccentSuccess">#059669</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentInfo">#2563EB</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentInfoLight">#3B82F6</SolidColorBrush>

                    <!-- Sidebar -->
                    <SolidColorBrush x:Key="SidebarIconMuted">#9CA3AF</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarIconActive">#111827</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarSelectedBg">#EEF1FA</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarDivider">#DEE5F0</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarGlow">#2563EB15</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarHover">#00000007</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Color x:Key="ColorBg">#000000</Color>
            <Color x:Key="ColorSurface">#14213D</Color>
            <Color x:Key="ColorSurface2">#1A1F36</Color>
            <Color x:Key="ColorBorder">#2D3748</Color>
