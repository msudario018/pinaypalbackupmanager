<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PinayPalBackupManager.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />

        <!-- GLASSMORPHISM STYLES -->
        <!-- Modern Glass Panel Style -->
        <Style Selector="Border.glass-panel">
            <Setter Property="Background" Value="#0A000000"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Opacity" Value="0.85"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.3"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Glass Panel with Blur Effect -->
        <Style Selector="Border.glass-panel-blur">
            <Setter Property="Background" Value="#0F000000"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.3"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Modern Sidebar Glass Style -->
        <Style Selector="Border.glass-sidebar">
            <Setter Property="Background" Value="#0D000000"/>
            <Setter Property="BorderBrush" Value="#15FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Opacity" Value="0.92"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.3"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Modern Top Bar Glass Style -->
        <Style Selector="Border.glass-topbar">
            <Setter Property="Background" Value="#0A000000"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Opacity" Value="0.88"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.3"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Modern Status Bar Glass Style -->
        <Style Selector="Border.glass-statusbar">
            <Setter Property="Background" Value="#0C000000"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Opacity" Value="0.9"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.3"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Enhanced Drop Shadow for Glass -->
        <Style Selector="Border.glass-shadow">
            <Setter Property="BoxShadow" Value="0 4 20 #20000000"/>
        </Style>

        <!-- Modern Button Glass Style -->
        <Style Selector="Button.glass-btn">
            <Setter Property="Background" Value="#0AFFFFFF"/>
            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.glass-btn:pointerover">
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="Opacity" Value="0.95"/>
            <Setter Property="RenderTransform" Value="scale(1.02) translateY(-1px)"/>
        </Style>

        <Style Selector="Button.glass-btn:pressed">
            <Setter Property="Background" Value="#08FFFFFF"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>

        <!-- GLOBAL ANIMATIONS & TRANSITIONS -->
        <!-- Global Button Animations - Optimized for faster theme switching -->
        <Style Selector="Button">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.08"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Sidebar Button Animations - Optimized -->
        <Style Selector="Button.SideBtn">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.SideBtn:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.08) translateY(-1px)"/>
        </Style>
        <Style Selector="Button.SideBtn:pressed">
            <Setter Property="RenderTransform" Value="scale(0.95)"/>
        </Style>
        <Style Selector="Button.SideBtn.Selected">
            <Setter Property="RenderTransform" Value="scale(1.0)"/>
        </Style>

        <!-- Border Animations - Optimized for faster theme switching -->
        <Style Selector="Border">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.08"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.08"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- TextBlock Animations - Optimized -->
        <Style Selector="TextBlock">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.08"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- ListBox Item Animations - Optimized -->
        <Style Selector="ListBoxItem">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.08"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.08"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- DataGridRow Animations - Optimized -->
        <Style Selector="DataGridRow">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.08"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.08"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Content Control Fade-in - Optimized -->
        <Style Selector="ContentControl">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Modern Glassmorphism Card Style -->
        <Style Selector="Border.glass">
            <Setter Property="Background" Value="{DynamicResource AppGlass}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BoxShadow" Value="0 4 16 #00000020, 0 8 32 #00000010"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.glass:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppGlassHover}"/>
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>

        <!-- Enhanced Modern Button Styles -->
        <Style Selector="Button.modern">
            <Setter Property="Background" Value="{DynamicResource AppSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.1"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.modern:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="RenderTransform" Value="scale(1.05) translateY(-2px)"/>
        </Style>
        <Style Selector="Button.modern:pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>

        <!-- Floating Action Button Style -->
        <Style Selector="Button.fab">
            <Setter Property="Background" Value="{DynamicResource AccentWebsite}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="50"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.fab:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.1) translateY(-4px)"/>
            <Setter Property="Background" Value="{DynamicResource AccentWebsiteLight}"/>
        </Style>

        <!-- ProgressBar smooth value transition and style - Optimized -->
        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="{DynamicResource AppBorder}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Value" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.Primary">
            <Setter Property="Background" Value="{DynamicResource AccentWebsite}"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,10"/>
        </Style>

        <Style Selector="Button.Primary.Ftp">
            <Setter Property="Background" Value="{DynamicResource AccentFtp}"/>
            <Setter Property="Foreground" Value="#000000"/>
        </Style>
        <Style Selector="Button.Primary.Mailchimp">
            <Setter Property="Background" Value="{DynamicResource AccentMailchimp}"/>
            <Setter Property="Foreground" Value="#000000"/>
        </Style>
        <Style Selector="Button.Primary.Sql">
            <Setter Property="Background" Value="{DynamicResource AccentSql}"/>
            <Setter Property="Foreground" Value="#000000"/>
        </Style>
        <Style Selector="Button.Primary.Settings">
            <Setter Property="Background" Value="{DynamicResource AccentWebsite}"/>
            <Setter Property="Foreground" Value="#000000"/>
        </Style>
        <Style Selector="Button.Primary.Website">
            <Setter Property="Background" Value="{DynamicResource AccentWebsite}"/>
            <Setter Property="Foreground" Value="#000000"/>
        </Style>
        <Style Selector="Button.Primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentWebsiteLight}"/>
            <Setter Property="RenderTransform" Value="scale(1.03)"/>
        </Style>
        <Style Selector="Button.Primary:pressed">
            <Setter Property="Background" Value="{DynamicResource AccentWebsiteDark}"/>
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

        <Style Selector="Button.Secondary">
            <Setter Property="Background" Value="{DynamicResource AppBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,9"/>
        </Style>
        <Style Selector="Button.Secondary:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppMuted}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        <Style Selector="Button.Secondary:pressed">
            <Setter Property="Background" Value="{DynamicResource AppSubtext}"/>
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

        <Style Selector="Button.Danger">
            <Setter Property="Background" Value="#0B0F17"/>
            <Setter Property="Foreground" Value="#F38BA8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,9"/>
        </Style>
        <Style Selector="Button.Danger:pointerover">
            <Setter Property="Background" Value="#FFB3C7"/>
            <Setter Property="Foreground" Value="#0B0F17"/>
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        <Style Selector="Button.Danger:pressed">
            <Setter Property="Background" Value="#E37A92"/>
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

        <!-- Admin Button Style - Uses muted color palette -->
        <Style Selector="Button.Admin">
            <Setter Property="Background" Value="{DynamicResource AppSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.Admin:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFtp}"/>
            <Setter Property="RenderTransform" Value="scale(1.03)"/>
        </Style>
        <Style Selector="Button.Admin:pressed">
            <Setter Property="Background" Value="{DynamicResource AppBorder}"/>
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>

        <Style Selector="Button.Ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style Selector="Button.Ghost:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppCard}"/>
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        <Style Selector="Button.Ghost:pressed">
            <Setter Property="Background" Value="{DynamicResource AppBorder}"/>
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <!-- Optimized Dark Theme - Better Contrast -->
                    <SolidColorBrush x:Key="AppBg">#0D1117</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSidebar">#161B22</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTopBar">#161B22</SolidColorBrush>
                    <SolidColorBrush x:Key="AppCard">#21262D</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSurface">#30363D</SolidColorBrush>
                    <SolidColorBrush x:Key="AppText">#E6EDF3</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSubtext">#8B949E</SolidColorBrush>
                    <SolidColorBrush x:Key="AppMuted">#6E7681</SolidColorBrush>
                    <SolidColorBrush x:Key="AppVeryMuted">#484F58</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBorder">#30363D</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBorder2">#21262D</SolidColorBrush>
                    
                    <!-- Enhanced Transparency Layers -->
                    <SolidColorBrush x:Key="AppGlass">#FFFFFF0A</SolidColorBrush>
                    <SolidColorBrush x:Key="AppGlassHover">#FFFFFF15</SolidColorBrush>
                    <SolidColorBrush x:Key="AppShadow">#00000050</SolidColorBrush>
                    <SolidColorBrush x:Key="AppOverlay">#0A0A0F80</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTimerAutoScan">#1A2D1A</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTimerDaily">#1A1A2D</SolidColorBrush>
                    <SolidColorBrush x:Key="AppManilaTime">#7EE787</SolidColorBrush>
                    <SolidColorBrush x:Key="AppLogText">#E6EDF3</SolidColorBrush>
                    <SolidColorBrush x:Key="AppWarning">#D29922</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBtnGreen">#0D2818</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBtnBlue">#0D1926</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBtnRed">#2D1515</SolidColorBrush>

                    <!-- Backup Tab Specific Colors -->
                    <!-- FTP/Website - Green Theme -->
                    <SolidColorBrush x:Key="AccentFtp">#3FB950</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpLight">#7EE787</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpDark">#238636</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpBg">#1B4332</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpMuted">#56D364</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpSurface">#3FB950</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpGlow">#3FB95040</SolidColorBrush>

                    <!-- Mailchimp - Blue Theme -->
                    <SolidColorBrush x:Key="AccentMailchimp">#58A6FF</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpLight">#79C0FF</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpDark">#1F6FEB</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpBg">#1B3A5C</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpMuted">#79C0FF</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpSurface">#58A6FF</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpGlow">#58A6FF40</SolidColorBrush>

                    <!-- SQL - Gold Theme -->
                    <SolidColorBrush x:Key="AccentSql">#D29922</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlLight">#E3B341</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlDark">#9E6A03</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlBg">#3D3000</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlMuted">#E3B341</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlSurface">#D29922</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlGlow">#D2992240</SolidColorBrush>

                    <!-- Website/General - Purple Accent -->
                    <SolidColorBrush x:Key="AccentWebsite">#A371F7</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteLight">#BC8CFF</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteDark">#8957E5</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteBg">#2D2345</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteMuted">#BC8CFF</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteSurface">#6E40C9</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteGlow">#A371F740</SolidColorBrush>

                    <!-- Error - Red -->
                    <SolidColorBrush x:Key="AccentError">#F85149</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorLight">#FF7B72</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorDark">#DA3633</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorBg">#2D1515</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorMuted">#FF7B72</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorSurface">#DA3633</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorGlow">#F8514940</SolidColorBrush>

                    <!-- Sidebar Theme -->
                    <SolidColorBrush x:Key="SidebarIconMuted">#8B949E</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarIconActive">#E6EDF3</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarSelectedBg">#30363D</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarDivider">#30363D</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarGlow">#A371F720</SolidColorBrush>
                    <SolidColorBrush x:Key="SidebarHover">#FFFFFF10</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <!-- Optimized Light Theme - Clean & Modern -->
                    <SolidColorBrush x:Key="AppBg">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSidebar">#F6F8FA</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTopBar">#F6F8FA</SolidColorBrush>
                    <SolidColorBrush x:Key="AppCard">#F6F8FA</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSurface">#EAEEF2</SolidColorBrush>
                    <SolidColorBrush x:Key="AppText">#1F2328</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSubtext">#656D76</SolidColorBrush>
                    <SolidColorBrush x:Key="AppMuted">#8B949E</SolidColorBrush>
                    <SolidColorBrush x:Key="AppVeryMuted">#6E7781</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBorder">#D0D7DE</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBorder2">#EAEEF2</SolidColorBrush>
                    
                    <!-- Enhanced Transparency Layers for Light Theme -->
                    <SolidColorBrush x:Key="AppGlass">#00000005</SolidColorBrush>
                    <SolidColorBrush x:Key="AppGlassHover">#00000010</SolidColorBrush>
                    <SolidColorBrush x:Key="AppShadow">#00000015</SolidColorBrush>
                    <SolidColorBrush x:Key="AppOverlay">#F8FAFC80</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTimerAutoScan">#F0FDF4</SolidColorBrush>
                    <SolidColorBrush x:Key="AppTimerDaily">#F8F8F8</SolidColorBrush>
                    <SolidColorBrush x:Key="AppManilaTime">#1A7F37</SolidColorBrush>
                    <SolidColorBrush x:Key="AppLogText">#1F2328</SolidColorBrush>
                    <SolidColorBrush x:Key="AppWarning">#9A6700</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBtnGreen">#DDF4DD</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBtnBlue">#DDF4FF</SolidColorBrush>
                    <SolidColorBrush x:Key="AppBtnRed">#FFEBE9</SolidColorBrush>

                    <!-- Backup Tab Specific Colors (Light) -->
                    <!-- FTP/Website - Green Theme -->
                    <SolidColorBrush x:Key="AccentFtp">#1A7F37</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpLight">#2DA44E</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpDark">#116329</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpBg">#DDF4DD</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpMuted">#2DA44E</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpSurface">#1A7F37</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFtpGlow">#1A7F3730</SolidColorBrush>

                    <!-- Mailchimp - Blue Theme -->
                    <SolidColorBrush x:Key="AccentMailchimp">#0969DA</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpLight">#218BFF</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpDark">#0550AE</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpBg">#DDF4FF</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpMuted">#218BFF</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpSurface">#0969DA</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentMailchimpGlow">#0969DA30</SolidColorBrush>

                    <!-- SQL - Gold Theme -->
                    <SolidColorBrush x:Key="AccentSql">#9A6700</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlLight">#BF8700</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlDark">#7D5000</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlBg">#FFF8C5</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlMuted">#BF8700</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlSurface">#9A6700</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSqlGlow">#9A670030</SolidColorBrush>

                    <!-- Website/General - Purple Accent -->
                    <SolidColorBrush x:Key="AccentWebsite">#8250DF</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteLight">#A475F9</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteDark">#6639BA</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteBg">#F5F0FF</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteMuted">#A475F9</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteSurface">#8250DF</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentWebsiteGlow">#8250DF30</SolidColorBrush>

                    <!-- Error - Red -->
                    <SolidColorBrush x:Key="AccentError">#CF222E</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorLight">#FF8182</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorDark">#A40E26</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentErrorBg">#FFEBE9</SolidColorBrush>
