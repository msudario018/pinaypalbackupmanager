<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:PinayPalBackupManager.UI.UserControls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="PinayPalBackupManager.UI.UserControls.HomeControl">
    <UserControl.Styles>
        <Style Selector="Ellipse.pulse">
            <Setter Property="Opacity" Value="1"/>
            <Style.Animations>
                <Animation Duration="0:0:1.6" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.3"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- Modern Card Style -->
        <Style Selector="Border.background-card">
            <Setter Property="Background" Value="{DynamicResource AppCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BoxShadow" Value="0 2 8 #00000018, 0 4 16 #0000000C"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.background-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder2}"/>
            <Setter Property="BoxShadow" Value="0 4 16 #00000025, 0 8 32 #00000010"/>
            <Setter Property="RenderTransform" Value="translateY(-3px)"/>
        </Style>
        <Style Selector="TextBlock.service-title">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="Button.service-action">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.service-action:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.05) translateY(-2px)"/>
        </Style>
        <Style Selector="Button.service-action:pressed">
            <Setter Property="RenderTransform" Value="scale(0.96)"/>
        </Style>
    </UserControl.Styles>
    <Border Background="Transparent" CornerRadius="12" Padding="0">
        <Grid RowDefinitions="Auto, *">
            <!-- Tab Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="24,20,24,16">
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="Dashboard" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AppText}"/>
                    <TextBlock Name="TxtGreeting" Text="Good Morning, User" FontSize="13" Foreground="{DynamicResource AppMuted}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Name="BtnViewAllBackups" Content="View All Backups" Background="{DynamicResource AppCard}" Foreground="{DynamicResource AppMuted}"
                            BorderThickness="0" CornerRadius="12" Padding="14,10" FontSize="12" Cursor="Hand" ToolTip.Tip="Open backup folder"/>
                    <Button Name="BtnCustomizeDashboard" Content="Customize" Background="{DynamicResource AppCard}" Foreground="{DynamicResource AppMuted}"
                            BorderThickness="0" CornerRadius="12" Padding="14,10" FontSize="12" Cursor="Hand"/>
                    <Border Name="DashHealthBadge" Background="{DynamicResource AppCard}" CornerRadius="12" Padding="14,10"
                            BoxShadow="0 1 4 #00000010">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse Name="DashHealthDot" Classes="pulse" Width="8" Height="8" Fill="{DynamicResource AppMuted}" VerticalAlignment="Center"/>
                            <TextBlock Name="DashHealthText" Text="SCANNING..." FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource AppMuted}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Name="BtnRunAllChecks" Content="Run All" Background="{DynamicResource AccentWebsite}" Foreground="#000000"
                            BorderThickness="0" CornerRadius="12" Padding="16,10" FontSize="12"
                            FontWeight="SemiBold" Cursor="Hand" ToolTip.Tip="Run parallel backup for all services"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="18" Margin="24,0,24,24">

            <!-- Retry Queue Badge -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Name="RetryQueueBadge" IsVisible="False" Background="{DynamicResource AccentError}" CornerRadius="10" Padding="8,4">
                    <TextBlock Name="TxtRetryQueue" Text="0 retries pending" FontSize="11" FontWeight="Bold" Foreground="White"/>
                </Border>
            </StackPanel>

            <!-- Alert Banner -->
            <Border Name="AlertBanner" IsVisible="False" Background="{DynamicResource AccentErrorBg}" BorderBrush="{DynamicResource AccentError}"
                    BorderThickness="1" CornerRadius="14" Padding="16,12"
                    BoxShadow="0 2 8 #FB718520">
                <Grid ColumnDefinitions="Auto, *">
                    <PathIcon Grid.Column="0" Data="M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z"
                              Width="18" Height="18" Foreground="{DynamicResource AccentError}" VerticalAlignment="Center"
                              Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" Name="AlertText" Text="" Foreground="{DynamicResource AccentError}" FontSize="13"
                               FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <!-- System Status Overview -->
            <Border Background="{DynamicResource AppCard}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="14" Padding="16"
                    BoxShadow="0 2 8 #00000018, 0 4 16 #0000000C">
                <Grid Name="SystemStatusGrid" ColumnDefinitions="*, *, *, Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="Uptime" FontSize="9" Foreground="{DynamicResource AppMuted}"/>
                        <TextBlock Name="SystemUptime" Text="-" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppSubtext}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="Last Health Check" FontSize="9" Foreground="{DynamicResource AppMuted}"/>
                        <TextBlock Name="LastHealthCheck" Text="-" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppSubtext}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Text="Active Processes" FontSize="9" Foreground="{DynamicResource AppMuted}"/>
                        <TextBlock Name="ActiveProcesses" Text="0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentFtp}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="2" Margin="16,0,0,0">
                        <TextBlock Text="Disk Space Available" FontSize="9" Foreground="{DynamicResource AppMuted}"/>
                        <TextBlock Name="StorageUsage" Text="-" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentWebsite}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Quick Stats Cards -->
            <Grid Name="QuickStatsGrid" ColumnDefinitions="*, *, *" MaxWidth="1200" HorizontalAlignment="Stretch" Margin="0,8,0,0">
                <Border Grid.Column="0" Margin="0,0,8,0" Background="{DynamicResource AppCard}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="14" Padding="14"
                        BoxShadow="0 2 8 #00000018, 0 4 16 #0000000C">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Backups Today" FontSize="9" Foreground="{DynamicResource AccentFtp}"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Name="StatBackupsToday" Text="0" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentFtp}"/>
                                <TextBlock Name="TrendBackups" Text="" FontSize="12" FontWeight="Bold" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Margin="0,0,8,0" Background="{DynamicResource AppCard}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="14" Padding="14"
                        BoxShadow="0 2 8 #00000018, 0 4 16 #0000000C">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Success Rate (24h)" FontSize="9" Foreground="{DynamicResource AccentWebsite}"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Name="StatSuccessRate" Text="100%" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentWebsite}"/>
                            <TextBlock Name="TrendSuccessRate" Text="" FontSize="12" FontWeight="Bold" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource AppCard}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="14" Padding="14"
                        BoxShadow="0 2 8 #00000018, 0 4 16 #0000000C">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Failed Backups" FontSize="9" Foreground="{DynamicResource AccentError}"/>
                        <TextBlock Name="StatFailedBackups" Text="0" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentError}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Time Since Last Backup -->
            <Border Background="{DynamicResource AppCard}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="16" Padding="16"
                    BoxShadow="0 2 8 #00000018, 0 4 16 #0000000C">
                <Grid Name="TimeSinceGrid" ColumnDefinitions="*, *">
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Bottom">
                        <TextBlock Text="Time Since Last Backup" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppMuted}" LetterSpacing="0.5" Margin="0,0,0,4"/>
                        <Grid ColumnDefinitions="Auto, 65, *, Auto" HorizontalAlignment="Stretch">
                            <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{DynamicResource AppText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="FTP" FontSize="11" Foreground="{DynamicResource AppSubtext}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Name="TimeSinceFtp" Text="-" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppText}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto, 75, *, Auto" HorizontalAlignment="Stretch">
                            <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{DynamicResource AppText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="Mailchimp" FontSize="11" Foreground="{DynamicResource AppSubtext}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Name="TimeSinceMc" Text="-" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppText}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto, 65, *, Auto" HorizontalAlignment="Stretch">
                            <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{DynamicResource AppText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="SQL" FontSize="11" Foreground="{DynamicResource AppSubtext}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Name="TimeSinceSql" Text="-" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppText}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Backup Summary (uses empty space) -->
                        <Border Height="1" Background="{DynamicResource AppBorder}" Margin="0,10,0,6"/>
                        <TextBlock Text="BACKUP SUMMARY" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppMuted}" LetterSpacing="0.5"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="Services Monitored" FontSize="11" Foreground="{DynamicResource AppSubtext}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="3" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppText}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="Next Backup In" FontSize="11" Foreground="{DynamicResource AppSubtext}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Name="TimeSinceNextIn" Text="--" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentWebsite}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="Overall Health" FontSize="11" Foreground="{DynamicResource AppSubtext}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Name="TimeSinceHealth" Text="--" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentSuccess}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="8,0" VerticalAlignment="Center">
                        <StackPanel Spacing="10" VerticalAlignment="Center">
                            <!-- Header row: label + active service indicator -->
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="GLOBAL BACKUP PROGRESS" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource AppMuted}" LetterSpacing="0.5" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Ellipse Name="GbpServiceDot" Width="6" Height="6" Fill="{DynamicResource AppMuted}" VerticalAlignment="Center"/>
                                    <TextBlock Name="GbpServiceName" Text="Idle" FontSize="9" Foreground="{DynamicResource AppMuted}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Main progress bar -->
                            <ProgressBar Name="GlobalBackupProgress" Value="0" Maximum="100" Height="7" CornerRadius="4"
                                         Foreground="{DynamicResource AppText}" Background="{DynamicResource AppBorder}"/>

                            <!-- Status + percent row -->
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Name="BackupProgressText" Text="No active backups"
                                           FontSize="9" Foreground="{DynamicResource AppSubtext}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Name="BackupProgressPercent" Text="0%"
                                           FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppText}" Margin="6,0,0,0"/>
                            </Grid>

                            <!-- Network Drive Mirror progress section (always visible like global progress) -->
                            <StackPanel Name="MirrorProgressSection" IsVisible="True" Spacing="10">
                                <Border Height="1" Background="{DynamicResource AppBorder}" Margin="0,2"/>

                                <!-- Header row: label + active service name -->
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <PathIcon Data="M15,20A1,1 0 0,0 16,19V4A1,1 0 0,0 15,3H7A1,1 0 0,0 6,4V8H4A2,2 0 0,0 2,10V20A1,1 0 0,0 3,21H15M7,5H15V8H7V5M4,10H8V12H10V10H14V18H4V10Z"
                                                  Width="10" Height="10" Foreground="#A78BFA" VerticalAlignment="Center"/>
                                        <TextBlock Text="NETWORK DRIVE MIRROR" FontSize="9" FontWeight="Bold"
                                                   Foreground="#A78BFA" LetterSpacing="0.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Name="MirrorServiceName" Text="Idle"
                                               FontSize="9" Foreground="#A78BFA" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Second progress bar (network drive mirror) -->
                                <ProgressBar Name="MirrorProgressBar" Value="0" Maximum="100" Height="7" CornerRadius="4"
                                             Foreground="#A78BFA" Background="{DynamicResource AppBorder}" Margin="15,0,0,0"/>

                                <!-- Status + percent row -->
                                <Grid ColumnDefinitions="*, Auto" Margin="15,0,0,0">
                                    <TextBlock Grid.Column="0" Name="MirrorProgressText" Text="Idle"
                                               FontSize="9" Foreground="{DynamicResource AppSubtext}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Name="MirrorProgressPercent" Text="0%"
                                               FontSize="9" FontWeight="Bold" Foreground="#A78BFA" Margin="6,0,0,0"/>
                                </Grid>

                                <!-- Status detail line below the progress bar -->
                                <TextBlock Name="MirrorStatusDetail" Text=""
                                           FontSize="9" Foreground="{DynamicResource AppMuted}" TextTrimming="CharacterEllipsis" Margin="15,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Schedule Overview -->
            <Border Background="{DynamicResource AppCard}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="16" Padding="20"
                    BoxShadow="0 2 8 #00000018, 0 4 16 #0000000C">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="SCHEDULE OVERVIEW" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppSubtext}" LetterSpacing="0.5" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Name="NextBackupCountdown" Text="Next in: --" FontSize="10" Foreground="{DynamicResource AppMuted}" VerticalAlignment="Center"/>
                    </Grid>
                    
                    <Grid Name="ScheduleOverviewGrid" ColumnDefinitions="*, *, *">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="FTP" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentFtp}"/>
                            <Grid ColumnDefinitions="Auto, *">
                                <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{DynamicResource AccentFtp}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Name="FtpScheduleTime" Text="--" FontSize="9" Foreground="{DynamicResource AppSubtext}"/>
                            </Grid>
                            <TextBlock Name="FtpScheduleStatus" Text="Scheduled" FontSize="8" Foreground="{DynamicResource AppVeryMuted}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Mailchimp" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentMailchimp}"/>
                            <Grid ColumnDefinitions="Auto, *">
                                <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{DynamicResource AccentMailchimp}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Name="McScheduleTime" Text="--" FontSize="9" Foreground="{DynamicResource AppSubtext}"/>
                            </Grid>
                            <TextBlock Name="McScheduleStatus" Text="Scheduled" FontSize="8" Foreground="{DynamicResource AppVeryMuted}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="SQL" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentSql}"/>
                            <Grid ColumnDefinitions="Auto, *">
                                <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{DynamicResource AccentSql}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Name="SqlScheduleTime" Text="--" FontSize="9" Foreground="{DynamicResource AppSubtext}"/>
                            </Grid>
                            <TextBlock Name="SqlScheduleStatus" Text="Scheduled" FontSize="8" Foreground="{DynamicResource AppVeryMuted}"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Upcoming Backups Preview -->
                    <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4,0,0">
                        <StackPanel Spacing="6">
                            <TextBlock Text="UPCOMING" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppMuted}" LetterSpacing="0.5"/>
                            <StackPanel Name="UpcomingBackupsList" Spacing="4"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Service Cards -->
            <Grid Name="ServiceCardsSection" ColumnDefinitions="*, *, *, *" MaxWidth="1200" HorizontalAlignment="Stretch">

                <!-- FTP Card -->
                <Border Grid.Column="0" Margin="0,0,8,0" Classes="background-card" CornerRadius="16" Padding="20" MinHeight="280">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Background="{DynamicResource AccentFtpBg}" CornerRadius="10" Padding="10" VerticalAlignment="Center"
                                    BoxShadow="0 1 4 #34D39920">
                                <PathIcon Data="M6,20C3.24,20 1,17.76 1,15C1,12.56 2.78,10.53 5.12,10.12C6.04,7.18 8.77,5 12,5C15.4,5 18.25,7.44 18.88,10.68C21.22,10.9 23,12.85 23,15.25C23,17.87 20.87,20 18.25,20H6Z"
                                          Width="20" Height="20" Foreground="{DynamicResource AccentFtp}"/>
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="FTP SYNC" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentFtp}"/>
                                <TextBlock Text="Website backup" FontSize="11" Foreground="{DynamicResource AppVeryMuted}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="10" Padding="12,8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Ellipse Name="FtpStatusDot" Classes="pulse" Width="8" Height="8" Fill="{DynamicResource AppMuted}" VerticalAlignment="Center"/>
                                <TextBlock Name="FtpStatusText" Text="SCANNING..." FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource AppMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="70, *">
                                <TextBlock Grid.Column="0" Text="Last sync" FontSize="10" Foreground="{DynamicResource AppMuted}"/>
                                <TextBlock Grid.Column="1" Name="FtpLastSync" Text="-" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppSubtext}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                            </Grid>
                            <Grid ColumnDefinitions="70, *">
                                <TextBlock Grid.Column="0" Text="Next scan" FontSize="10" Foreground="{DynamicResource AppMuted}"/>
                                <TextBlock Grid.Column="1" Name="FtpNextScan" Text="-" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppSubtext}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock Name="FtpLastSummary" Text="" FontSize="9" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap"/>

                        <!-- Quick Actions -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Name="BtnFtpSyncCheck" Content="Sync Check" Classes="service-action"
                                    Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppText}" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch"/>
                            <Button Name="BtnFtpQuickBackup" Content="Quick Backup" Classes="service-action"
                                    Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppText}" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <!-- Mirror to Network Drive -->
                        <Button Name="BtnFtpMirror" Content="Mirror to Network Drive" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Background="{DynamicResource AccentWebsiteBg}" Foreground="{DynamicResource AccentWebsite}"
                                BorderBrush="{DynamicResource AccentWebsite}" BorderThickness="1" CornerRadius="10" Padding="10,6" FontSize="10"
                                FontWeight="SemiBold" Cursor="Hand"/>

                        <!-- Open Tab -->
                        <Button Name="BtnGoFtp" Content="Open FTP Tab" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Background="{DynamicResource AccentFtpBg}" Foreground="{DynamicResource AccentFtp}"
                                BorderThickness="0" CornerRadius="10" Padding="12,10" FontSize="11"
                                FontWeight="SemiBold" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- Mailchimp Card -->
                <Border Grid.Column="1" Margin="4,0" Classes="background-card" CornerRadius="16" Padding="20" MinHeight="280">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Background="{DynamicResource AccentMailchimpBg}" CornerRadius="10" Padding="10" VerticalAlignment="Center"
                                    BoxShadow="0 1 4 #60A5FA20">
                                <PathIcon Data="M20,4H4C2.9,4 2,4.9 2,6V18C2,19.1 2.9,20 4,20H20C21.1,20 22,19.1 22,18V6C22,4.9 21.1,4 20,4M20,18H4V8L12,13L20,8V18M12,11L4,6H20L12,11Z"
                                          Width="20" Height="20" Foreground="{DynamicResource AccentMailchimp}"/>
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="MAILCHIMP" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentMailchimp}"/>
                                <TextBlock Text="Email backup" FontSize="11" Foreground="{DynamicResource AppVeryMuted}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="10" Padding="12,8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Ellipse Name="MailchimpStatusDot" Classes="pulse" Width="8" Height="8" Fill="{DynamicResource AppMuted}" VerticalAlignment="Center"/>
                                <TextBlock Name="MailchimpStatusText" Text="SCANNING..." FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource AppMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="70, *">
                                <TextBlock Grid.Column="0" Text="Last sync" FontSize="10" Foreground="{DynamicResource AppMuted}"/>
                                <TextBlock Grid.Column="1" Name="MailchimpLastSync" Text="-" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppSubtext}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                            </Grid>
                            <Grid ColumnDefinitions="70, *">
                                <TextBlock Grid.Column="0" Text="Next scan" FontSize="10" Foreground="{DynamicResource AppMuted}"/>
                                <TextBlock Grid.Column="1" Name="MailchimpNextScan" Text="-" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppSubtext}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock Name="MailchimpLastSummary" Text="" FontSize="9" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap"/>

                        <!-- Quick Actions -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Name="BtnMcSyncCheck" Content="Sync Check" Classes="service-action"
                                    Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppText}" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch"/>
                            <Button Name="BtnMcQuickBackup" Content="Quick Backup" Classes="service-action"
                                    Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppText}" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <!-- Mirror to Network Drive -->
                        <Button Name="BtnMcMirror" Content="Mirror to Network Drive" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Background="{DynamicResource AccentWebsiteBg}" Foreground="{DynamicResource AccentWebsite}"
                                BorderBrush="{DynamicResource AccentWebsite}" BorderThickness="1" CornerRadius="10" Padding="10,6" FontSize="10"
                                FontWeight="SemiBold" Cursor="Hand"/>

                        <!-- Open Tab -->
                        <Button Name="BtnGoMailchimp" Content="Open Mailchimp Tab" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Background="{DynamicResource AccentMailchimpBg}" Foreground="{DynamicResource AccentMailchimp}"
                                BorderThickness="0" CornerRadius="10" Padding="12,10" FontSize="11"
                                FontWeight="SemiBold" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- SQL Card -->
                <Border Grid.Column="2" Margin="4,0" Classes="background-card" CornerRadius="16" Padding="20" MinHeight="280">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Background="{DynamicResource AccentSqlBg}" CornerRadius="10" Padding="10" VerticalAlignment="Center"
                                    BoxShadow="0 1 4 #FBBF2420">
                                <PathIcon Data="M12,3C7.58,3 4,4.79 4,7C4,9.21 7.58,11 12,11C16.42,11 20,9.21 20,7C20,4.79 16.42,3 12,3M4,9V12C4,14.21 7.58,16 12,16C16.42,16 20,14.21 20,12V9C20,11.21 16.42,13 12,13C7.58,13 4,11.21 4,9M4,14V17C4,19.21 7.58,21 12,21C16.42,21 20,19.21 20,17V14C20,16.21 16.42,18 12,18C7.58,18 4,16.21 4,14Z"
                                          Width="20" Height="20" Foreground="{DynamicResource AccentSql}"/>
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="SQL BACKUP" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentSql}"/>
                                <TextBlock Text="Database backup" FontSize="11" Foreground="{DynamicResource AppVeryMuted}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="10" Padding="12,8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Ellipse Name="SqlStatusDot" Classes="pulse" Width="8" Height="8" Fill="{DynamicResource AppMuted}" VerticalAlignment="Center"/>
                                <TextBlock Name="SqlStatusText" Text="SCANNING..." FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource AppMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="70, *">
                                <TextBlock Grid.Column="0" Text="Last sync" FontSize="10" Foreground="{DynamicResource AppMuted}"/>
                                <TextBlock Grid.Column="1" Name="SqlLastSync" Text="-" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppSubtext}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                            </Grid>
                            <Grid ColumnDefinitions="70, *">
                                <TextBlock Grid.Column="0" Text="Next scan" FontSize="10" Foreground="{DynamicResource AppMuted}"/>
                                <TextBlock Grid.Column="1" Name="SqlNextScan" Text="-" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppSubtext}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock Name="SqlLastSummary" Text="" FontSize="9" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap"/>

                        <!-- Quick Actions -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Name="BtnSqlSyncCheck" Content="Sync Check" Classes="service-action"
                                    Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppText}" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch"/>
                            <Button Name="BtnSqlQuickBackup" Content="Quick Backup" Classes="service-action"
                                    Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppText}" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <!-- Mirror to Network Drive -->
                        <Button Name="BtnSqlMirror" Content="Mirror to Network Drive" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Background="{DynamicResource AccentWebsiteBg}" Foreground="{DynamicResource AccentWebsite}"
                                BorderBrush="{DynamicResource AccentWebsite}" BorderThickness="1" CornerRadius="10" Padding="10,6" FontSize="10"
                                FontWeight="SemiBold" Cursor="Hand"/>

                        <!-- Open Tab -->
                        <Button Name="BtnGoSql" Content="Open SQL Tab" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Background="{DynamicResource AccentSqlBg}" Foreground="{DynamicResource AccentSql}"
                                BorderThickness="0" CornerRadius="10" Padding="12,10" FontSize="11"
                                FontWeight="SemiBold" Cursor="Hand"/>
                    </StackPanel>
                </Border>
                <!-- Network Drive Card -->
                <Border Name="NetworkDriveCard" Grid.Column="3" Margin="8,0,0,0" Classes="background-card" CornerRadius="16" Padding="20" MinHeight="280">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Background="{DynamicResource AccentWebsiteBg}" CornerRadius="10" Padding="10" VerticalAlignment="Center"
                                    BoxShadow="0 1 4 #A78BFA20">
                                <PathIcon Data="M15,20A1,1 0 0,0 16,19V4A1,1 0 0,0 15,3H7A1,1 0 0,0 6,4V8H4A2,2 0 0,0 2,10V20A1,1 0 0,0 3,21H15M7,5H15V8H7V5M4,10H8V12H10V10H14V18H4V10Z"
                                          Width="20" Height="20" Foreground="{DynamicResource AccentWebsite}"/>
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="NETWORK DRIVE" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentWebsite}"/>
                                <TextBlock Text="Mirror backup" FontSize="11" Foreground="{DynamicResource AppVeryMuted}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="10" Padding="12,8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Ellipse Name="NdStatusDot" Width="8" Height="8" Fill="{DynamicResource AppMuted}" VerticalAlignment="Center"/>
                                <TextBlock Name="NdStatusText" Text="CHECKING..." FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource AppMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="70, *">
                                <TextBlock Grid.Column="0" Text="Path" FontSize="10" Foreground="{DynamicResource AppMuted}"/>
                                <TextBlock Grid.Column="1" Name="NdPath" Text="—" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppSubtext}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                            </Grid>
                            <Grid ColumnDefinitions="70, *">
                                <TextBlock Grid.Column="0" Text="Last mirror" FontSize="10" Foreground="{DynamicResource AppMuted}"/>
                                <TextBlock Grid.Column="1" Name="NdLastMirror" Text="—" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AppSubtext}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock Name="NdSummary" Text="" FontSize="9" Foreground="{DynamicResource AppMuted}" TextWrapping="Wrap"/>

                        <!-- Quick Actions -->
                        <Button Name="BtnNdMirrorAll" Content="Mirror All Now" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Background="{DynamicResource AccentWebsite}" Foreground="#000000"
                                BorderThickness="0" CornerRadius="10" Padding="12,8" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>

                        <!-- Open Folder -->
                        <Button Name="BtnOpenNetworkDrive" Content="Open Network Drive Folder" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppText}"
                                BorderThickness="0" CornerRadius="8" Padding="10,8" FontSize="11"
                                FontWeight="SemiBold" Cursor="Hand"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Backup Health Dashboard -->
            <Border Background="{DynamicResource AppCard}" CornerRadius="14" Padding="20">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*, Auto, Auto">
                        <TextBlock Text="BACKUP HEALTH" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppSubtext}" LetterSpacing="0.5" VerticalAlignment="Center"/>
                        <Ellipse Grid.Column="1" Name="HealthAutoRefreshIndicator" Classes="pulse" Width="6" Height="6" Fill="{DynamicResource AccentFtp}" VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="False"/>
                        <Button Grid.Column="2" Name="BtnRefreshHealth" Content="Auto" Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppSubtext}" BorderThickness="0" CornerRadius="6" Padding="8,4" FontSize="10" Cursor="Hand"/>
                    </Grid>
                    
                    <!-- Health Score -->
                    <Grid Name="HealthDashboardGrid" ColumnDefinitions="Auto, *, Auto">
                        <Border Grid.Column="0" Background="{DynamicResource AppCard}" CornerRadius="12" Padding="20,16" Margin="0,0,16,0" VerticalAlignment="Center">
                            <StackPanel Spacing="4">
                                <TextBlock Name="HealthScoreText" Text="-" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentFtp}" HorizontalAlignment="Center" Padding="4,2"/>
                                <TextBlock Name="HealthTrendText" Text="Calculating..." FontSize="10" Foreground="{DynamicResource AppMuted}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        
                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                            <Grid ColumnDefinitions="Auto, 70, Auto">
                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{DynamicResource AccentFtp}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Grid.Column="1" Text="FTP" FontSize="11" Foreground="{DynamicResource AppSubtext}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Name="HealthFtpScore" Text="-" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentFtp}" HorizontalAlignment="Left" Margin="0,0,0,0" Padding="0,0"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto, 70, Auto">
                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{DynamicResource AccentMailchimp}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Grid.Column="1" Text="Mailchimp" FontSize="11" Foreground="{DynamicResource AppSubtext}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Name="HealthMcScore" Text="-" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentMailchimp}" HorizontalAlignment="Left" Margin="0,0,0,0" Padding="0,0"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto, 70, Auto">
                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{DynamicResource AccentSql}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Grid.Column="1" Text="SQL" FontSize="11" Foreground="{DynamicResource AppSubtext}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Name="HealthSqlScore" Text="-" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentSql}" HorizontalAlignment="Left" Margin="0,0,0,0" Padding="0,0"/>
                            </Grid>
                        </StackPanel>
                        
                        <Border Grid.Column="2" Background="{DynamicResource AppSurface}" CornerRadius="8" Padding="12,8" VerticalAlignment="Center">
                            <StackPanel Spacing="4">
                                <TextBlock Text="CRITICAL ALERTS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppMuted}" LetterSpacing="0.5" HorizontalAlignment="Center"/>
                                <TextBlock Name="CriticalAlertsCount" Text="0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentError}" HorizontalAlignment="Center"/>
                                <TextBlock Text="need attention" FontSize="9" Foreground="{DynamicResource AppVeryMuted}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    
                </StackPanel>
            </Border>

            <!-- Operations -->
            <Border Classes="background-card" CornerRadius="12" Padding="18">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="OPERATIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppSubtext}" LetterSpacing="0.5" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Name="BtnMaintenanceToggle" Content="Pause All" Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppSubtext}" BorderThickness="0" CornerRadius="6" Padding="8,4" FontSize="10" FontWeight="SemiBold" Cursor="Hand"/>
                            <Button Name="BtnEmergencyStop" Content="Stop All" Background="{DynamicResource AppCard}" Foreground="#F38BA8" BorderThickness="0" CornerRadius="6" Padding="8,4" FontSize="10" FontWeight="SemiBold" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                    <Grid Name="OperationsGrid" ColumnDefinitions="*, *, *">
                        <Button Name="BtnBackupAll" Grid.Column="0" Margin="0,0,6,0" Content="Backup All" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppText}" BorderThickness="0" CornerRadius="6" Padding="10,8" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                        <Button Name="BtnTestAllConn" Grid.Column="1" Margin="3,0" Content="Test All" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppText}" BorderThickness="0" CornerRadius="6" Padding="10,8" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                        <Button Name="BtnRetryFailed" Grid.Column="2" Margin="6,0,0,0" Content="Retry Failed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppText}" BorderThickness="0" CornerRadius="6" Padding="10,8" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                    </Grid>
                    <TextBlock Name="TxtOperationsStatus" Text="" FontSize="10" Foreground="{DynamicResource AppSubtext}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Recent Errors Panel -->
            <Border Name="RecentErrorsPanel" Background="#2D1515" CornerRadius="12" Padding="16" IsVisible="False">
                <Grid RowDefinitions="Auto, *">
                    <!-- Header Row -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,8">
                        <TextBlock Grid.Column="0" Text="!" FontSize="16" Foreground="#F38BA8" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="RECENT ERRORS" FontSize="11" FontWeight="Bold" Foreground="#F38BA8" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Name="BtnClearErrors" Content="Clear" Background="{DynamicResource AppCard}" Foreground="#F38BA8"
                                BorderThickness="0" CornerRadius="6" Padding="10,6" FontSize="10" Cursor="Hand" VerticalAlignment="Center"/>
                    </Grid>
                    <!-- Content Row -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                        <StackPanel Name="RecentErrorsList" Spacing="4"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Quick Stats Row -->
            <Grid Name="QuickStatsRowGrid" ColumnDefinitions="*, *">
                <Border Grid.Column="0" Margin="0,0,8,0" Classes="background-card" CornerRadius="10" Padding="16,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="TOTAL FILES" FontSize="9" Foreground="{DynamicResource AppMuted}" FontWeight="Bold" LetterSpacing="1"/>
                        <TextBlock Name="StatTotalFiles" Text="-" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppText}"/>
                        <TextBlock Text="across all backups" FontSize="10" Foreground="{DynamicResource AppVeryMuted}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Margin="6,0" Classes="background-card" CornerRadius="10" Padding="16,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="STORAGE USED" FontSize="9" Foreground="{DynamicResource AppMuted}" FontWeight="Bold" LetterSpacing="1"/>
                        <TextBlock Name="StatStorage" Text="-" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppText}"/>
                        <TextBlock Text="total backup size" FontSize="10" Foreground="{DynamicResource AppVeryMuted}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Backup Size Breakdown -->
            <Border Background="{DynamicResource AppCard}" CornerRadius="14" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="STORAGE BREAKDOWN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppSubtext}" LetterSpacing="0.5"/>
                    <Grid Name="StorageBreakdownGrid" ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Spacing="8">
                            <Grid ColumnDefinitions="Auto, Auto, *">
                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#588157" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="FTP" FontSize="10" Foreground="{DynamicResource AppSubtext}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="2" Name="StorageFtpBreakdown" Text="-" FontSize="10" FontWeight="SemiBold" Foreground="#588157" HorizontalAlignment="Left"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto, Auto, *">
                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#00b4d8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="Mailchimp" FontSize="10" Foreground="{DynamicResource AppSubtext}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="2" Name="StorageMcBreakdown" Text="-" FontSize="10" FontWeight="SemiBold" Foreground="#00b4d8" HorizontalAlignment="Left"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto, Auto, *">
                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#e6c55c" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="SQL" FontSize="10" Foreground="{DynamicResource AppSubtext}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="2" Name="StorageSqlBreakdown" Text="-" FontSize="10" FontWeight="SemiBold" Foreground="#e6c55c" HorizontalAlignment="Left"/>
                            </Grid>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource AppSurface}" CornerRadius="8" Padding="12,8" VerticalAlignment="Center">
                            <StackPanel Spacing="4">
                                <TextBlock Text="TOTAL" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppMuted}" LetterSpacing="0.5" HorizontalAlignment="Center"/>
                                <TextBlock Name="StorageTotal" Text="-" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppText}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!-- Storage Progress Bars -->
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <TextBlock Grid.Column="0" Text="FTP" FontSize="9" Foreground="{DynamicResource AppMuted}" Width="30" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Column="1" Name="StorageFtpBarBreakdown" Value="0" Maximum="100" Height="4" CornerRadius="2" Margin="8,0,8,0" Foreground="{DynamicResource AccentFtp}" Background="{DynamicResource AppBorder}"/>
                            <TextBlock Grid.Column="2" Name="StorageFtpPercentBreakdown" Text="0%" FontSize="9" Foreground="{DynamicResource AppMuted}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <TextBlock Grid.Column="0" Text="MC" FontSize="9" Foreground="{DynamicResource AppMuted}" Width="30" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Column="1" Name="StorageMcBarBreakdown" Value="0" Maximum="100" Height="4" CornerRadius="2" Margin="8,0,8,0" Foreground="{DynamicResource AccentMailchimp}" Background="{DynamicResource AppBorder}"/>
                            <TextBlock Grid.Column="2" Name="StorageMcPercentBreakdown" Text="0%" FontSize="9" Foreground="{DynamicResource AppMuted}" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <TextBlock Grid.Column="0" Text="SQL" FontSize="9" Foreground="{DynamicResource AppMuted}" Width="30" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Column="1" Name="StorageSqlBarBreakdown" Value="0" Maximum="100" Height="4" CornerRadius="2" Margin="8,0,8,0" Foreground="{DynamicResource AccentSql}" Background="{DynamicResource AppBorder}"/>
                            <TextBlock Grid.Column="2" Name="StorageSqlPercentBreakdown" Text="0%" FontSize="9" Foreground="{DynamicResource AppMuted}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Connectivity + Stats Row -->
            <Grid Name="ConnectivityStatsGrid" ColumnDefinitions="*, *">

                <!-- Connectivity -->
                <Border Grid.Column="0" Margin="0,0,8,0" Background="{DynamicResource AppCard}" CornerRadius="14" Padding="20">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="CONNECTIVITY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppSubtext}" LetterSpacing="0.5" VerticalAlignment="Center"/>
                            <Button Name="BtnPingAll" Grid.Column="1" Content="Test All" Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppSubtext}" BorderThickness="0" CornerRadius="8" Padding="10,5" FontSize="10" Cursor="Hand"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Ellipse Grid.Column="0" Name="PingFtpDot" Classes="pulse" Width="8" Height="8" Fill="#6C7086" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="FTP Server" FontSize="11" Foreground="{DynamicResource AppSubtext}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Name="PingFtpText" Text="-" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppMuted}"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Ellipse Grid.Column="0" Name="PingSqlDot" Classes="pulse" Width="8" Height="8" Fill="#6C7086" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="SQL Server" FontSize="11" Foreground="{DynamicResource AppSubtext}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Name="PingSqlText" Text="-" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppMuted}"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Ellipse Grid.Column="0" Name="PingMcDot" Classes="pulse" Width="8" Height="8" Fill="#6C7086" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="Mailchimp API" FontSize="11" Foreground="{DynamicResource AppSubtext}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Name="PingMcText" Text="-" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppMuted}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Stats & Reporting -->
                <Border Grid.Column="1" Background="{DynamicResource AppCard}" CornerRadius="14" Padding="20">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="BACKUP STATS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppSubtext}" LetterSpacing="0.5"/>
                            <Ellipse Grid.Column="1" Name="StatsAutoRefreshIndicator" Classes="pulse" Width="6" Height="6" Fill="#00b4d8" VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="False"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto, *">
                            <Border Grid.Column="0" Background="#344e41" CornerRadius="6" Padding="10,5" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Name="TxtStreak" Text="0d" FontSize="14" FontWeight="Bold" Foreground="#588157"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Backup streak" FontSize="10" Foreground="{DynamicResource AppSubtext}"/>
                                <TextBlock Name="TxtLastFailure" Text="Calculating..." FontSize="10" Foreground="{DynamicResource AppMuted}"/>
                            </StackPanel>
                        </Grid>
                        <!-- 7-Day Heatmap -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="LAST 7 DAYS" FontSize="9" Foreground="{DynamicResource AppMuted}" FontWeight="Bold" LetterSpacing="0.5"/>
                            <StackPanel Name="HeatmapRow" Orientation="Horizontal" Spacing="4"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*, *">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="THIS WEEK" FontSize="9" Foreground="{DynamicResource AppMuted}" FontWeight="Bold" LetterSpacing="0.5"/>
                                <TextBlock Name="TxtWeekBackups" Text="-" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppText}"/>
                                <TextBlock Text="backups run" FontSize="9" Foreground="{DynamicResource AppVeryMuted}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="AVG DURATION" FontSize="9" Foreground="{DynamicResource AppMuted}" FontWeight="Bold" LetterSpacing="0.5"/>
                                <TextBlock Name="TxtAvgDuration" Text="-" FontSize="22" FontWeight="Bold" Foreground="#00b4d8"/>
                                <TextBlock Text="per backup" FontSize="9" Foreground="{DynamicResource AppVeryMuted}"/>
                            </StackPanel>
                        </Grid>
                        <!-- Per-service stats -->
                        <Border Background="{DynamicResource AppSurface}" CornerRadius="6" Padding="10,8">
                            <StackPanel Spacing="5">
                                <TextBlock Text="PER SERVICE" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource AppMuted}" LetterSpacing="0.5"/>
                                <Grid ColumnDefinitions="Auto, 30, Auto">
                                    <Ellipse Grid.Column="0" Width="6" Height="6" Fill="#588157" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Grid.Column="1" Text="FTP" FontSize="10" Foreground="{DynamicResource AppSubtext}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Name="StatFtpRate" Text="-" FontSize="10" FontWeight="SemiBold" Foreground="#588157" HorizontalAlignment="Left" Margin="0,0,0,0" Padding="0,0"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto, 50, Auto">
                                    <Ellipse Grid.Column="0" Width="6" Height="6" Fill="#00b4d8" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Grid.Column="1" Text="Mailchimp" FontSize="10" Foreground="{DynamicResource AppSubtext}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Name="StatMcRate" Text="-" FontSize="10" FontWeight="SemiBold" Foreground="#00b4d8" HorizontalAlignment="Left" Margin="0,0,0,0" Padding="0,0"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto, 25, Auto">
                                    <Ellipse Grid.Column="0" Width="6" Height="6" Fill="#fad643" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Grid.Column="1" Text="SQL" FontSize="10" Foreground="{DynamicResource AppSubtext}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Name="StatSqlRate" Text="-" FontSize="10" FontWeight="SemiBold" Foreground="#fad643" HorizontalAlignment="Left" Margin="0,0,0,0" Padding="0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Schedule Adjustment -->
            <Border Background="{DynamicResource AppCard}" CornerRadius="14" Padding="20">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="SCHEDULE ADJUSTMENT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppSubtext}" LetterSpacing="0.5"/>
                        <TextBlock Name="SchedSummaryText" Text="Loading schedule..." FontSize="10" Foreground="{DynamicResource AppMuted}"/>
                    </StackPanel>
                    <Button Name="BtnOpenSchedule" Grid.Column="1" Content="Edit Schedule" Background="#CBA6F7" Foreground="#000000" BorderThickness="0" CornerRadius="8" Padding="14,8" FontSize="11" FontWeight="Bold" Cursor="Hand" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Firebase Sync Status -->
            <Border Background="{DynamicResource AppCard}" CornerRadius="14" Padding="20">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*, Auto, 6, Auto">
                        <TextBlock Grid.Column="0" Text="FIREBASE SYNC STATUS" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource AppSubtext}" LetterSpacing="0.5" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Name="BtnRefreshFirebaseLogs" Content="Refresh"
                                Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppSubtext}" BorderThickness="0"
                                CornerRadius="8" Padding="10,5" FontSize="10" Cursor="Hand"/>
                        <Button Grid.Column="3" Name="BtnViewFirebaseLogs" Content="View All Logs"
                                Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppSubtext}" BorderThickness="0"
                                CornerRadius="8" Padding="10,5" FontSize="10" Cursor="Hand"/>
                    </Grid>
                    <Border Background="#1E1E2E" CornerRadius="8" Padding="12" Height="150">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Name="FirebaseLogsText" FontFamily="Consolas, Courier New, monospace" FontSize="10"
                                       Foreground="{DynamicResource AppSubtext}" TextWrapping="Wrap" Text="Loading Firebase sync logs..."/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Storage Usage + Daily Schedule Row -->
            <Grid Name="StorageScheduleGrid" ColumnDefinitions="*, *">

                <!-- Storage Usage -->
                <Border Grid.Column="0" Margin="0,0,8,0" Background="{DynamicResource AppCard}" CornerRadius="14" Padding="20">
                    <StackPanel Spacing="14">
                        <TextBlock Text="STORAGE USAGE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppSubtext}" LetterSpacing="0.5"/>
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="100, *">
                                    <TextBlock Grid.Column="0" Text="FTP / Website" FontSize="11" Foreground="{DynamicResource AppSubtext}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Name="StorageFtp" Text="-" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentFtp}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <ProgressBar Name="StorageFtpBar" Height="4" CornerRadius="2" Background="{DynamicResource AppSurface}" Value="0" Maximum="100" Foreground="{DynamicResource AccentFtp}"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="100, *">
                                    <TextBlock Grid.Column="0" Text="Mailchimp" FontSize="11" Foreground="{DynamicResource AppSubtext}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Name="StorageMailchimp" Text="-" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentMailchimp}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <ProgressBar Name="StorageMailchimpBar" Height="4" CornerRadius="2" Background="{DynamicResource AppSurface}" Value="0" Maximum="100" Foreground="{DynamicResource AccentMailchimp}"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="100, *">
                                    <TextBlock Grid.Column="0" Text="SQL / Database" FontSize="11" Foreground="{DynamicResource AppSubtext}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Name="StorageSql" Text="-" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentSql}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <ProgressBar Name="StorageSqlBar" Height="4" CornerRadius="2" Background="{DynamicResource AppSurface}" Value="0" Maximum="100" Foreground="{DynamicResource AccentSql}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Daily Schedule -->
                <Border Grid.Column="1" Background="{DynamicResource AppCard}" CornerRadius="14" Padding="20">
                    <StackPanel Spacing="14">
                        <TextBlock Text="DAILY SCHEDULE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppSubtext}" LetterSpacing="0.5"/>
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#588157" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="FTP / Website" FontSize="11" Foreground="{DynamicResource AppSubtext}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Name="SchedFtp" Text="-" FontSize="11" FontWeight="SemiBold" Foreground="#588157" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#00b4d8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="Mailchimp" FontSize="11" Foreground="{DynamicResource AppSubtext}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Name="SchedMailchimp" Text="-" FontSize="11" FontWeight="SemiBold" Foreground="#00b4d8" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#fad643" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="SQL / Database" FontSize="11" Foreground="{DynamicResource AppSubtext}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Name="SchedSql" Text="-" FontSize="11" FontWeight="SemiBold" Foreground="#fad643" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent Activity -->
            <Border Background="{DynamicResource AppCard}" CornerRadius="14" Padding="20">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Text="RECENT ACTIVITY" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource AppSubtext}" LetterSpacing="0.5" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Name="BtnExportCsv" Content="Export CSV"
                                Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppSubtext}" BorderThickness="0"
                                CornerRadius="8" Padding="10,5" FontSize="10" Cursor="Hand"/>
                    </Grid>
                    <StackPanel Name="ActivityList" Spacing="4"/>
                </StackPanel>
            </Border>

            <!-- Activity Heatmap -->
            <Border Background="{DynamicResource AppCard}" CornerRadius="14" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="ACTIVITY HEATMAP (LAST 52 WEEKS)" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource AppSubtext}" LetterSpacing="0.5"/>
                    
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="Less" FontSize="10" Foreground="{DynamicResource AppMuted}"/>
                            <StackPanel Grid.Column="1" Name="HeatmapContainer" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center"/>
                            <Button Grid.Column="2" Name="BtnHeatmapMore" Content="More →" FontSize="10"
                                    Background="Transparent" Foreground="{DynamicResource AppMuted}" BorderThickness="0"
                                    Padding="4,2" Cursor="Hand" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Month labels -->
                        <Grid ColumnDefinitions="*, *, *, *, *, *, *, *, *, *, *, *" Name="MonthLabelsContainer" Margin="0,8,0,0"/>
                        
                        <!-- Day labels -->
                        <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,4,0,0">
                            <TextBlock Text="Mon" FontSize="9" Foreground="{DynamicResource AppMuted}" Width="20" TextAlignment="Center"/>
                            <TextBlock Text="" FontSize="9" Foreground="{DynamicResource AppMuted}" Width="20" TextAlignment="Center"/>
                            <TextBlock Text="Wed" FontSize="9" Foreground="{DynamicResource AppMuted}" Width="20" TextAlignment="Center"/>
                            <TextBlock Text="" FontSize="9" Foreground="{DynamicResource AppMuted}" Width="20" TextAlignment="Center"/>
                            <TextBlock Text="Fri" FontSize="9" Foreground="{DynamicResource AppMuted}" Width="20" TextAlignment="Center"/>
                            <TextBlock Text="" FontSize="9" Foreground="{DynamicResource AppMuted}" Width="20" TextAlignment="Center"/>
                            <TextBlock Text="Sun" FontSize="9" Foreground="{DynamicResource AppMuted}" Width="20" TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <Grid ColumnDefinitions="Auto, *" Margin="0,8,0,0">
                        <TextBlock Grid.Column="0" Name="HeatmapSummary" Text="0 backups in the last year" FontSize="12" Foreground="{DynamicResource AppMuted}"/>
                        <TextBlock Grid.Column="1" Name="HeatmapStreak" Text="Current streak: 0 days" FontSize="12" Foreground="{DynamicResource AppMuted}" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Backup History Calendar -->
            <Border Background="{DynamicResource AppCard}" CornerRadius="14" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="BACKUP HISTORY (LAST 30 DAYS)" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource AppSubtext}" LetterSpacing="0.5"/>
                    <WrapPanel Name="BackupCalendar"></WrapPanel>
                </StackPanel>
            </Border>

            <!-- Keyboard Shortcuts Footer -->
            <Border Background="{DynamicResource AppCard}" CornerRadius="10" Padding="12,8" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Background="{DynamicResource AppBorder}" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="Ctrl+B" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppMuted}"/>
                        </Border>
                        <TextBlock Text="Backup All" FontSize="10" Foreground="{DynamicResource AppMuted}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Background="{DynamicResource AppBorder}" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="Ctrl+T" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppMuted}"/>
                        </Border>
                        <TextBlock Text="Test All" FontSize="10" Foreground="{DynamicResource AppMuted}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Background="{DynamicResource AppBorder}" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="Ctrl+R" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppMuted}"/>
                        </Border>
                        <TextBlock Text="Retry Failed" FontSize="10" Foreground="{DynamicResource AppMuted}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Background="{DynamicResource AppBorder}" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="Esc" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppMuted}"/>
                        </Border>
                        <TextBlock Text="Emergency Stop" FontSize="10" Foreground="{DynamicResource AppMuted}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Grid>
</Border>
</UserControl>
