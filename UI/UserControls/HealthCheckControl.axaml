<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PinayPalBackupManager.UI.UserControls.HealthCheckControl">
    <Border Background="{DynamicResource AppCard}" CornerRadius="12" Padding="0">
        <Grid RowDefinitions="Auto, *">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="20">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="SYSTEM HEALTH CHECK" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppText}"/>
                    <TextBlock Text="Monitor system health and component status" FontSize="12" Foreground="{DynamicResource AppMuted}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Name="BtnRunCheck" Content="Run Check" Classes="Primary"
                            BorderThickness="0" CornerRadius="8" Padding="16,8" FontSize="12" Cursor="Hand" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="20" Margin="20">
                    <!-- Overall Status -->
                    <Border Background="{DynamicResource AppSurface}" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="5">
                            <TextBlock Name="TxtOverallStatus" Text="Status: Unknown" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Name="TxtLastCheck" Text="Last check: Never" Foreground="{DynamicResource AppMuted}" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Component Health -->
                    <Border Background="{DynamicResource AppSurface}" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="15">
                            <TextBlock Text="COMPONENT HEALTH" FontWeight="Bold" Foreground="{DynamicResource AppText}" FontSize="12"/>
                            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                <StackPanel Name="ComponentList" Spacing="10"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- System Resources -->
                    <Border Background="{DynamicResource AppSurface}" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="15">
                            <TextBlock Text="SYSTEM RESOURCES" FontWeight="Bold" Foreground="{DynamicResource AppText}" FontSize="12"/>
                            <StackPanel Name="ResourceList" Spacing="10"/>
                        </StackPanel>
                    </Border>

                    <!-- Warnings -->
                    <Border Background="{DynamicResource AppSurface}" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="15">
                            <TextBlock Text="WARNINGS" FontWeight="Bold" Foreground="{DynamicResource AppWarning}" FontSize="12"/>
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                <StackPanel Name="WarningList" Spacing="8"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Errors -->
                    <Border Background="{DynamicResource AppSurface}" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="15">
                            <TextBlock Text="ERRORS" FontWeight="Bold" Foreground="{DynamicResource AccentError}" FontSize="12"/>
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                <StackPanel Name="ErrorList" Spacing="8"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Actions -->
                    <Grid ColumnDefinitions="*, *" Margin="0,0,0,20">
                        <Button Name="BtnExport" Classes="Secondary" Content="Export Report" HorizontalAlignment="Stretch" Margin="0,0,5,0"/>
                        <Button Name="BtnClear" Classes="Secondary" Grid.Column="1" Content="Clear History" HorizontalAlignment="Stretch" Margin="5,0,0,0"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
