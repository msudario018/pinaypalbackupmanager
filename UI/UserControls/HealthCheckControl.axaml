<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PinayPalBackupManager.UI.UserControls.HealthCheckControl">
    <Border Background="#0D1117" CornerRadius="12" Padding="0">
        <StackPanel Spacing="0">
            <!-- Header with Close Button -->
            <Grid Background="#161B22" Height="50" ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" Text="SYSTEM HEALTH CHECK" FontWeight="Bold" Foreground="{DynamicResource AccentWebsite}" FontSize="14" VerticalAlignment="Center" Margin="20,0"/>
                <Button Name="BtnClose" Grid.Column="1" Content="✕" Classes="Ghost" Width="40" Height="40" Margin="10" FontSize="18" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </Grid>

            <!-- Content -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="20" Margin="20">
                    <!-- Overall Status -->
                    <Border Background="#161B22" CornerRadius="12" Padding="20">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Spacing="5">
                                <TextBlock Name="TxtOverallStatus" Text="Status: Unknown" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Name="TxtLastCheck" Text="Last check: Never" Foreground="#8B949E" FontSize="12"/>
                            </StackPanel>
                            <Button Name="BtnRunCheck" Grid.Column="1" Classes="Primary" Content="Run Check" Margin="10,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Component Health -->
                    <Border Background="#161B22" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="15">
                            <TextBlock Text="COMPONENT HEALTH" FontWeight="Bold" Foreground="{DynamicResource AppText}" FontSize="12"/>
                            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                <StackPanel Name="ComponentList" Spacing="10"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- System Resources -->
                    <Border Background="#161B22" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="15">
                            <TextBlock Text="SYSTEM RESOURCES" FontWeight="Bold" Foreground="{DynamicResource AppText}" FontSize="12"/>
                            <StackPanel Name="ResourceList" Spacing="10"/>
                        </StackPanel>
                    </Border>

                    <!-- Warnings -->
                    <Border Background="#161B22" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="15">
                            <TextBlock Text="WARNINGS" FontWeight="Bold" Foreground="#D29922" FontSize="12"/>
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                <StackPanel Name="WarningList" Spacing="8"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Errors -->
                    <Border Background="#161B22" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="15">
                            <TextBlock Text="ERRORS" FontWeight="Bold" Foreground="#F85149" FontSize="12"/>
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                <StackPanel Name="ErrorList" Spacing="8"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Actions -->
                    <Grid ColumnDefinitions="*, *" Margin="0,0,0,20">
                        <Button Name="BtnExport" Classes="Secondary" Content="Export Report" HorizontalAlignment="Stretch" Margin="0,0,5,0"/>
                        <Button Name="BtnClear" Classes="Secondary" Grid.Column="1" Content="Clear History" HorizontalAlignment="Stretch" Margin="5,0,0,0"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </Border>
</UserControl>
