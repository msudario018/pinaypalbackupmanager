<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PinayPalBackupManager.UI.UserControls.CollapsibleCardControl"
             HorizontalAlignment="Stretch">

    <Border Name="CardRoot"
            Background="{DynamicResource AppCard}"
            BorderBrush="{DynamicResource AppBorder}"
            BorderThickness="1"
            CornerRadius="12">

        <StackPanel>
            <!-- Clickable header row: the whole header toggles the card -->
            <Button Name="HeaderButton"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="20,16"
                    HorizontalContentAlignment="Stretch"
                    Cursor="Hand"
                    Focusable="False">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <!-- Accent stripe that lights up when expanded -->
                    <Border Name="AccentStripe"
                            Grid.Column="0"
                            Width="3"
                            Height="30"
                            CornerRadius="2"
                            Background="{DynamicResource AppBorder}"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center"/>

                    <!-- Icon -->
                    <Border Grid.Column="0"
                            Width="34" Height="34"
                            CornerRadius="9"
                            Background="{DynamicResource AppSurface}"
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <PathIcon Name="HeaderIcon"
                                  Width="18" Height="18"
                                  Foreground="{DynamicResource AppMuted}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>

                    <!-- Title + subtitle -->
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Name="HeaderTitleText"
                                       Text="Section"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="{DynamicResource AppText}"/>
                            <Border Name="HeaderBadge"
                                    IsVisible="False"
                                    Background="#2010B981"
                                    BorderBrush="#10B981"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,1"
                                    VerticalAlignment="Center">
                                <TextBlock Name="HeaderBadgeText"
                                           Text="BADGE"
                                           FontSize="8.5"
                                           FontWeight="Bold"
                                           Foreground="#10B981"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Name="HeaderSubtitleText"
                                   Text=""
                                   FontSize="11"
                                   Foreground="{DynamicResource AppMuted}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Chevron -->
                    <PathIcon Name="ChevronIcon"
                              Grid.Column="2"
                              Data="M7.41,8.59L12,13.17L16.59,8.59L18,10L12,16L6,10L7.41,8.59Z"
                              Width="18" Height="18"
                              Foreground="{DynamicResource AppMuted}"
                              VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <!-- Body is only realised while expanded, so inputs cost nothing when collapsed -->
            <Border Name="ContentHost"
                    IsVisible="False"
                    Padding="20,0,20,20">
                <StackPanel Name="ContentHostPanel" Spacing="12"/>
            </Border>
        </StackPanel>
    </Border>
</UserControl>