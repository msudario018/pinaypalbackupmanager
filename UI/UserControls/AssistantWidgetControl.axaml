<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PinayPalBackupManager.UI.UserControls.AssistantWidgetControl">
    
    <Grid>
        <!-- Stack containing:
             1. Proactive Speech Bubble Popup (shown on login or event)
             2. Conversational Chat Drawer Window (when expanded)
             3. Floating Avatar Pill Button (always visible in corner)
        -->
        <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="12">
            
            <!-- 1. Proactive Speech Bubble Popup -->
            <Border Name="SpeechBubbleBorder"
                    IsVisible="False"
                    Width="320"
                    Background="#101726F5"
                    BorderBrush="#F59E0B"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14,12"
                    BoxShadow="0 8 28 #00000060, 0 2 8 #F59E0B20">
                <Grid RowDefinitions="Auto, Auto, Auto">
                    <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#10B981"/>
                            <TextBlock Text="PINAYPAL AI" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" LetterSpacing="1"/>
                        </StackPanel>
                        <Button Grid.Column="1" Name="BtnCloseBubble"
                                Background="Transparent" BorderThickness="0" Padding="4,2" Cursor="Hand">
                            <TextBlock Text="✕" FontSize="11" Foreground="#94A3B8"/>
                        </Button>
                    </Grid>
                    
                    <TextBlock Name="TxtBubbleContent" Grid.Row="1"
                               Text="Good day! PinayPal is running smoothly."
                               FontSize="12" Foreground="#F8FAFC" TextWrapping="Wrap" LineHeight="17" Margin="0,0,0,8"/>
                               
                    <Button Grid.Row="2" Name="BtnOpenFromBubble"
                            Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1"
                            CornerRadius="8" Padding="10,5" HorizontalAlignment="Right" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Open Chat" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="→" FontSize="11"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Expandable Conversational Chat Drawer -->
            <Border Name="ChatDrawerBorder"
                    IsVisible="False"
                    Width="390" Height="520"
                    Background="#090D16FA"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="18"
                    BoxShadow="0 16 48 #00000090, 0 4 16 #0284C720">
                <Grid RowDefinitions="Auto, *, Auto, Auto">
                    
                    <!-- Drawer Header -->
                    <Border Grid.Row="0" Background="#0F172AF0" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="14,12" CornerRadius="18,18,0,0">
                        <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#1E293B" BorderBrush="#F59E0B" BorderThickness="1" Margin="0,0,10,0">
                                <PathIcon Data="M12,2L14.5,8.5L21,9L16,14L17.5,21L12,17.5L6.5,21L8,14L3,9L9.5,8.5L12,2Z" Width="16" Height="16" Foreground="#F59E0B" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="PinayPal AI Assistant" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    <Border Name="ProviderBadge" Background="#1E293B" CornerRadius="4" Padding="5,1">
                                        <TextBlock Name="TxtProviderBadge" Text="HYBRID" FontSize="8" FontWeight="Bold" Foreground="#38BDF8"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Guarded &amp; Zero-Leak Sanitized" FontSize="10" Foreground="#94A3B8"/>
                            </StackPanel>
                            <Button Grid.Column="2" Name="BtnClearChat" ToolTip.Tip="Clear conversation"
                                    Background="Transparent" BorderThickness="0" Padding="6" Margin="0,0,4,0" Cursor="Hand">
                                <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" Width="14" Height="14" Foreground="#64748B"/>
                            </Button>
                            <Button Grid.Column="3" Name="BtnCloseDrawer" ToolTip.Tip="Close chat"
                                    Background="Transparent" BorderThickness="0" Padding="6" Cursor="Hand">
                                <TextBlock Text="✕" FontSize="13" Foreground="#94A3B8" FontWeight="Bold"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Messages ScrollViewer -->
                    <ScrollViewer Name="MessagesScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,10">
                        <StackPanel Name="MessagesContainer" Spacing="10"/>
                    </ScrollViewer>

                    <!-- Quick Prompt Chips Row -->
                    <Border Grid.Row="2" Background="#0C1322" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="10,8">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Classes="ChipBtn" Name="ChipHealth" Content="Health Status"/>
                                <Button Classes="ChipBtn" Name="ChipDisk" Content="Check Disk Space"/>
                                <Button Classes="ChipBtn" Name="ChipFtp" Content="Run FTP Backup"/>
                                <Button Classes="ChipBtn" Name="ChipTunnel" Content="Tunnel Status"/>
                                <Button Classes="ChipBtn" Name="ChipEmail" Content="Test Email"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Input Box -->
                    <Border Grid.Row="3" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="10,10" CornerRadius="0,0,18,18">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBox Name="TxtInput"
                                     Watermark="Ask anything or request an action..."
                                     Background="#1E293B"
                                     Foreground="#F8FAFC"
                                     BorderBrush="#334155"
                                     BorderThickness="1"
                                     CornerRadius="10"
                                     Padding="12,9"
                                     FontSize="12"/>
                            <Button Grid.Column="1" Name="BtnSend"
                                    Background="#F59E0B" Foreground="#0A0E18"
                                    BorderThickness="0" CornerRadius="10"
                                    Width="36" Height="36" Margin="8,0,0,0"
                                    Cursor="Hand" ToolTip.Tip="Send message">
                                <PathIcon Data="M2,21L23,12L2,3V10L17,12L2,14V21Z" Width="14" Height="14" Foreground="#0A0E18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 3. Floating Avatar Pill Button -->
            <Button Name="BtnAvatarTrigger"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Cursor="Hand"
                    HorizontalAlignment="Right"
                    ToolTip.Tip="PinayPal AI Assistant">
                <Border Width="56" Height="56"
                        CornerRadius="28"
                        Background="#0F172AF0"
                        BorderBrush="#F59E0B"
                        BorderThickness="1.5"
                        BoxShadow="0 8 24 #00000060, 0 0 16 #F59E0B30">
                    <Grid>
                        <!-- Sparkle Bot Icon -->
                        <PathIcon Data="M12,2L14.5,8.5L21,9L16,14L17.5,21L12,17.5L6.5,21L8,14L3,9L9.5,8.5L12,2Z"
                                  Width="22" Height="22"
                                  Foreground="#F59E0B"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        <!-- Operational Pulse Dot -->
                        <Ellipse Name="DotPulse" Width="9" Height="9"
                                 Fill="#10B981"
                                 Stroke="#0F172A" StrokeThickness="1.5"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Margin="0,0,10,10"/>
                    </Grid>
                </Border>
            </Button>
            
        </StackPanel>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.ChipBtn">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.ChipBtn:pointerover">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#F59E0B"/>
        </Style>
    </UserControl.Styles>
</UserControl>
