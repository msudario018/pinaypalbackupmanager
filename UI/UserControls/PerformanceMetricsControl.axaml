<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PinayPalBackupManager.UI.UserControls.PerformanceMetricsControl">
    <Border Background="{DynamicResource AppCard}" CornerRadius="12" Padding="0">
        <Grid RowDefinitions="Auto, *">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="20">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="PERFORMANCE METRICS" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppText}"/>
                    <TextBlock Text="Monitor backup performance and success rates" FontSize="12" Foreground="{DynamicResource AppMuted}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Name="BtnRefresh" Content="Refresh" Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppSubtext}"
                            BorderThickness="0" CornerRadius="8" Padding="16,8" FontSize="12" Cursor="Hand"/>
                    <Button Name="BtnExport" Content="Export" Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppSubtext}"
                            BorderThickness="0" CornerRadius="8" Padding="16,8" FontSize="12" Cursor="Hand"/>
                    <Button Name="BtnClear" Content="Clear" Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppSubtext}"
                            BorderThickness="0" CornerRadius="8" Padding="16,8" FontSize="12" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="20" Margin="20">
                    <!-- Summary -->
                    <Border Background="{DynamicResource AppSurface}" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="5">
                            <TextBlock Name="TxtSummary" Text="Loading..." Foreground="{DynamicResource AppMuted}" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Backup Success Rates -->
                    <Border Background="{DynamicResource AppSurface}" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="15">
                            <TextBlock Text="BACKUP SUCCESS RATES" FontWeight="Bold" Foreground="{DynamicResource AppText}" FontSize="12"/>
                            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                <StackPanel Name="SuccessRatePanel" Spacing="10"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Average Backup Times -->
                    <Border Background="{DynamicResource AppSurface}" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="15">
                            <TextBlock Text="AVERAGE BACKUP TIMES" FontWeight="Bold" Foreground="{DynamicResource AppText}" FontSize="12"/>
                            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                <StackPanel Name="BackupTimePanel" Spacing="10"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Metric Summaries -->
                    <Border Background="{DynamicResource AppSurface}" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="15">
                            <TextBlock Text="METRIC SUMMARIES" FontWeight="Bold" Foreground="{DynamicResource AppText}" FontSize="12"/>
                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                <StackPanel Name="MetricSummaryPanel" Spacing="10"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
