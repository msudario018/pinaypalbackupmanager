<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PinayPalBackupManager.UI.UserControls.BackupScheduleControl">
    <Border Background="{DynamicResource AppCard}" CornerRadius="12" Padding="0">
        <Grid RowDefinitions="Auto, *">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="20">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="BACKUP SCHEDULES" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppText}"/>
                    <TextBlock Text="Manage automated backup schedules" FontSize="12" Foreground="{DynamicResource AppMuted}"/>
                </StackPanel>
                <Button Name="BtnCreate" Grid.Column="1" Content="New Schedule" Classes="Primary"
                        BorderThickness="0" CornerRadius="8" Padding="16,8" FontSize="12" Cursor="Hand" VerticalAlignment="Center"/>
            </Grid>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" Name="MainScrollViewer" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="20" Margin="20">
                    <!-- Summary -->
                    <Border Background="{DynamicResource AppSurface}" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="5">
                            <TextBlock Name="TxtSummary" Text="Loading..." Foreground="{DynamicResource AppMuted}" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Schedule List -->
                    <Border Background="{DynamicResource AppSurface}" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="15">
                            <TextBlock Text="ACTIVE SCHEDULES" FontWeight="Bold" Foreground="{DynamicResource AppText}" FontSize="12"/>
                            <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                                <StackPanel Name="ScheduleList" Spacing="10"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Create/Edit Form -->
                    <Border Name="BorderForm" Background="{DynamicResource AppSurface}" CornerRadius="12" Padding="20" IsVisible="False" Margin="0,0,0,20">
                        <StackPanel Spacing="15">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="SCHEDULE DETAILS" FontWeight="Bold" Foreground="{DynamicResource AppText}" FontSize="12"/>
                                <Button Name="BtnCloseForm" Grid.Column="1" Classes="Ghost" Content="✕" Margin="10,0,0,0"/>
                            </Grid>
                            
                            <StackPanel Spacing="10">
                                <TextBlock Text="Name:" FontWeight="SemiBold" Foreground="{DynamicResource AppMuted}" FontSize="11"/>
                                <TextBox Name="TxtName" Watermark="Schedule name"/>
                            </StackPanel>

                            <StackPanel Spacing="10">
                                <TextBlock Text="Service:" FontWeight="SemiBold" Foreground="{DynamicResource AppMuted}" FontSize="11"/>
                                <ComboBox Name="CmbService" SelectedIndex="0">
                                    <ComboBoxItem Content="all"/>
                                    <ComboBoxItem Content="ftp"/>
                                    <ComboBoxItem Content="sql"/>
                                    <ComboBoxItem Content="mailchimp"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="10">
                                <TextBlock Text="Type:" FontWeight="SemiBold" Foreground="{DynamicResource AppMuted}" FontSize="11"/>
                                <ComboBox Name="CmbType" SelectionChanged="OnTypeChanged">
                                    <ComboBoxItem Content="Once"/>
                                    <ComboBoxItem Content="Daily"/>
                                    <ComboBoxItem Content="Weekly"/>
                                    <ComboBoxItem Content="Monthly"/>
                                    <ComboBoxItem Content="Interval"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Name="PanelInterval" Spacing="10" IsVisible="False">
                                <TextBlock Text="Interval (hours):" FontWeight="SemiBold" Foreground="{DynamicResource AppMuted}" FontSize="11"/>
                                <NumericUpDown Name="NumInterval" Value="6" Minimum="1" Maximum="168"/>
                            </StackPanel>

                            <StackPanel Name="PanelOneTime" Spacing="10" IsVisible="False">
                                <TextBlock Text="Date &amp; Time:" FontWeight="SemiBold" Foreground="{DynamicResource AppMuted}" FontSize="11"/>
                                <CalendarDatePicker Name="DateOneTime"/>
                                <TimePicker Name="TimeOneTime" SelectedTime="12:00"/>
                            </StackPanel>

                            <StackPanel Spacing="10">
                                <TextBlock Text="Backup Type:" FontWeight="SemiBold" Foreground="{DynamicResource AppMuted}" FontSize="11"/>
                                <ComboBox Name="CmbBackupType" SelectedIndex="0">
                                    <ComboBoxItem Content="Full"/>
                                    <ComboBoxItem Content="Incremental"/>
                                </ComboBox>
                            </StackPanel>

                            <CheckBox Name="ChkEnabled" Content="Enabled" IsChecked="True"/>

                            <Grid ColumnDefinitions="*, *" Margin="0,0,0,20">
                                <Button Name="BtnSave" Classes="Primary" Content="Save" HorizontalAlignment="Stretch" Margin="0,0,5,0"/>
                                <Button Name="BtnCancel" Classes="Secondary" Grid.Column="1" Content="Cancel" HorizontalAlignment="Stretch" Margin="5,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
