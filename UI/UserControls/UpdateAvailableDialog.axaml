<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PinayPalBackupManager.UI.UserControls.UpdateAvailableDialog"
             Width="520" Height="410">
    
    <Border Background="{DynamicResource AppCard}" CornerRadius="16" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Padding="26" BoxShadow="0 16 40 #50000000">
        <Grid RowDefinitions="Auto, Auto, *, Auto">
            <!-- Header with Icon & Title -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="0,0,0,14">
                <Border Width="40" Height="40" CornerRadius="10" Background="#1c2d27" BorderBrush="#34D39940" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                    <PathIcon Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M11,7V13H13V7H11M11,15V17H13V15H11Z" 
                              Width="20" Height="20" Foreground="#34D399" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Software Update Available" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AppText}"/>
                    <TextBlock Text="A new version of PinayPal Backup Manager is ready to install." FontSize="11" Foreground="{DynamicResource AppSubtext}"/>
                </StackPanel>
            </Grid>
            
            <!-- Version Badge Row -->
            <Border Grid.Row="1" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Target Version:" FontSize="11" Foreground="{DynamicResource AppSubtext}" VerticalAlignment="Center"/>
                        <TextBlock Name="TxtVersion" Text="v3.6.7" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentWebsite}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="#163828" CornerRadius="6" Padding="8,3" BorderBrush="#34D39940" BorderThickness="1">
                        <TextBlock Text="RECOMMENDED" FontSize="9" FontWeight="Bold" Foreground="#34D399" LetterSpacing="0.5"/>
                    </Border>
                </Grid>
            </Border>
            
            <!-- Changelog Content -->
            <Border Grid.Row="2" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,18">
                <Grid RowDefinitions="Auto, *">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                        <TextBlock Text="✦" FontSize="11" Foreground="{DynamicResource AccentWarning}"/>
                        <TextBlock Text="Release Highlights:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentWarning}"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="160">
                        <TextBlock Name="TxtChangelog" Text="" Foreground="{DynamicResource AppText}" FontSize="11" LineHeight="18" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Grid>
            </Border>
            
            <!-- Action Buttons -->
            <Grid Grid.Row="3" ColumnDefinitions="*, Auto, Auto">
                <TextBlock Grid.Column="0" Text="Do you want to update now?" FontSize="11" Foreground="{DynamicResource AppMuted}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Name="BtnNo" Content="Remind Me Later" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Foreground="{DynamicResource AppSubtext}" 
                        Padding="18,9" CornerRadius="8" FontSize="12" FontWeight="SemiBold" Margin="0,0,10,0" Cursor="Hand"/>
                <Button Grid.Column="2" Name="BtnYes" Content="Install &amp; Restart" Background="{DynamicResource AccentSuccess}" Foreground="#0D1117" 
                        Padding="22,9" CornerRadius="8" FontSize="12" FontWeight="Bold" Cursor="Hand"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
