<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:PinayPalBackupManager.UI.UserControls"
             x:Class="PinayPalBackupManager.UI.UserControls.SettingsControl">
    <Border Background="Transparent" CornerRadius="12" Padding="0">
        <Grid RowDefinitions="Auto, *">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="20">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="SETTINGS" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppText}"/>
                    <TextBlock Text="Configure application preferences and backup options" FontSize="12" Foreground="{DynamicResource AppMuted}"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="20" Margin="20">

            <!-- App Updates (1st) -->
            <ui:CollapsibleCardControl Title="App Updates"
                                       Subtitle="Check for PinayPal releases and download them automatically."
                                       IconData="M12,4L12,1L8,5L12,9L12,6C15.31,6 18,8.69 18,12C18,13.01 17.75,13.97 17.31,14.8L18.77,16.26C19.54,15.03 20,13.57 20,12A8,8 0 0,0 12,4M12,18C8.69,18 6,15.31 6,12C6,10.99 6.25,10.03 6.69,9.2L5.23,7.74C4.46,8.97 4,10.43 4,12A8,8 0 0,0 12,20L12,23L16,19L12,15L12,18Z"
                                       Accent="#F59E0B">
                <StackPanel Spacing="10">
                    <CheckBox Name="ChkAutoUpdate" Content="Check for updates on startup" Foreground="{DynamicResource AppText}" Margin="0,0,0,8"/>
                    <Button Name="BtnCheckUpdates" Classes="Primary Settings" Content="CHECK FOR UPDATES" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </StackPanel>
            </ui:CollapsibleCardControl>

            <!-- Backup Health Dashboard (2nd) -->
            <ui:CollapsibleCardControl Title="Backup Health Dashboard"
                                       Subtitle="Run every backup service on demand and inspect the latest diagnostics."
                                       IconData="M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5C2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35M16.5,5C14.63,5 13,6.5 12,8.5C11,6.5 9.37,5 7.5,5C5.5,5 4,6.5 4,8.5C4,11.5 7,14.5 12,18.5C17,14.5 20,11.5 20,8.5C20,6.5 18.5,5 16.5,5Z"
                                       Accent="#10B981">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*, *, *">
                        <!-- FTP -->
                        <Border Grid.Column="0" Margin="0,0,6,0" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="10" Padding="12">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Name="DiagFtpDot" Width="8" Height="8" Fill="{DynamicResource AppMuted}" VerticalAlignment="Center"/>
                                    <TextBlock Text="FTP" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentFtp}"/>
                                </StackPanel>
                                <TextBlock Name="DiagFtpStatus" Text="—" FontSize="10" Foreground="{DynamicResource AppSubtext}" TextWrapping="Wrap"/>
                                <TextBlock Name="DiagFtpTime" Text="—" FontSize="9" Foreground="{DynamicResource AppMuted}"/>
                                <Button Name="BtnRunFtp" Content="Run Now" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppText}"
                                        BorderThickness="0" CornerRadius="6" Padding="6,4" FontSize="10" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                        <!-- Mailchimp -->
                        <Border Grid.Column="1" Margin="3,0" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="10" Padding="12">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Name="DiagMcDot" Width="8" Height="8" Fill="{DynamicResource AppMuted}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Mailchimp" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentMailchimp}"/>
                                </StackPanel>
                                <TextBlock Name="DiagMcStatus" Text="—" FontSize="10" Foreground="{DynamicResource AppSubtext}" TextWrapping="Wrap"/>
                                <TextBlock Name="DiagMcTime" Text="—" FontSize="9" Foreground="{DynamicResource AppMuted}"/>
                                <Button Name="BtnRunMailchimp" Content="Run Now" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppText}"
                                        BorderThickness="0" CornerRadius="6" Padding="6,4" FontSize="10" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                        <!-- SQL -->
                        <Border Grid.Column="2" Margin="6,0,0,0" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="10" Padding="12">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Name="DiagSqlDot" Width="8" Height="8" Fill="{DynamicResource AppMuted}" VerticalAlignment="Center"/>
                                    <TextBlock Text="SQL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentSql}"/>
                                </StackPanel>
                                <TextBlock Name="DiagSqlStatus" Text="—" FontSize="10" Foreground="{DynamicResource AppSubtext}" TextWrapping="Wrap"/>
                                <TextBlock Name="DiagSqlTime" Text="—" FontSize="9" Foreground="{DynamicResource AppMuted}"/>
                                <Button Name="BtnRunSql" Content="Run Now" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppText}"
                                        BorderThickness="0" CornerRadius="6" Padding="6,4" FontSize="10" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Button Name="BtnDiagnostics" Classes="Primary Settings" Content="RUN SYSTEM DIAGNOSTICS" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Name="TxtHealthStatus" Text="Status: Pending Scan..." Foreground="{DynamicResource AppSubtext}" FontStyle="Italic" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                    </StackPanel>
            </ui:CollapsibleCardControl>

            <!-- System Configuration (3rd) -->
            <ui:CollapsibleCardControl Title="System Configuration"
                                       Subtitle="Startup behaviour, tray integration, language, and backup retention."
                                       IconData="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.97 19.05,5.05L16.56,6.05C16.04,5.66 15.48,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.52,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.72,4.97 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.52,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.48,18.68 16.04,18.34 16.56,17.94L19.05,18.95C19.28,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                                       Accent="#38BDF8">
                    <StackPanel Spacing="4">
                    <CheckBox Name="ChkStartup" Content="Run Backup on Windows Start Up" Foreground="{DynamicResource AppText}"/>
                    <CheckBox Name="ChkStartMinimized" Content="Start Minimized to Tray" Foreground="{DynamicResource AppText}" Margin="0,4,0,0"/>
                    <CheckBox Name="ChkMinimizeToTray" Content="Minimize to System Tray" Foreground="{DynamicResource AppText}" Margin="0,4,0,0"/>
                    <CheckBox Name="ChkCloseToTray" Content="Close Button (X) Minimizes to Tray" Foreground="{DynamicResource AppText}" Margin="0,4,0,0"/>
                    <CheckBox Name="ChkAutoTls" Content="Auto-Update TLS Certificate on Renewal" Foreground="{DynamicResource AppText}" Margin="0,4,0,0"/>
                    <CheckBox Name="ChkDailyHealth" Content="Run Daily Automated Health Check" Foreground="{DynamicResource AppText}" Margin="0,4,0,0"/>
                    <CheckBox Name="ChkNotificationSound" Content="Play Sound on Backup Complete" Foreground="{DynamicResource AppText}" Margin="0,4,0,0"/>
                                        <Grid ColumnDefinitions="*, Auto" Margin="0,8,0,0">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <ui:LocalizedTextBlock Key="language" Foreground="{DynamicResource AppText}" FontWeight="SemiBold" FontSize="12"/>
                            <ui:LocalizedTextBlock Key="language_description" Foreground="{DynamicResource AppMuted}" FontSize="10"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Name="CmbLanguage" Width="140" SelectedIndex="0" VerticalAlignment="Center">
                            <ComboBoxItem Content="English"/>
                            <ComboBoxItem Content="Filipino"/>
                        </ComboBox>
                    </Grid>
                    <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,8,0,0">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Backup Retention" Foreground="{DynamicResource AppText}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="Days to keep old backup files before auto-delete" Foreground="{DynamicResource AppMuted}" FontSize="10"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Name="TxtRetentionDays" Width="54" TextAlignment="Center" FontSize="13" FontWeight="Bold" Background="{DynamicResource AppSurface}" Foreground="{DynamicResource AccentWebsite}" BorderBrush="{DynamicResource AppBorder}" CornerRadius="6" Padding="8,5" Margin="10,0,6,0"/>
                        <TextBlock Grid.Column="2" Text="days" FontSize="11" Foreground="{DynamicResource AppMuted}" VerticalAlignment="Center"/>
                    </Grid>
                    <Button Name="BtnSaveRetention" Content="Save Retention Policy" Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppText}" BorderThickness="0" CornerRadius="8" Padding="14,8" FontSize="11" HorizontalAlignment="Left" Cursor="Hand"/>
                    <Button Name="BtnExportLogs" Content="Export Logs (ZIP)" Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppText}" BorderThickness="0" CornerRadius="8" Padding="14,8" FontSize="11" HorizontalAlignment="Left" Cursor="Hand" Margin="0,8,0,0"/>
                    </StackPanel>
            </ui:CollapsibleCardControl>

            <!-- AI Assistant & Automation Engine -->
            <ui:CollapsibleCardControl x:Name="CardAiAssistant"
                                       Title="AI Assistant &amp; Automation Engine"
                                       Subtitle="Talk to your assistant, tune its personality, and choose which engine thinks for you."
                                       Badge="ZERO-LEAK SHIELD"
                                       IconData="M12,1.5 C12,7.3 7.3,12 1.5,12 C7.3,12 12,16.7 12,22.5 C12,16.7 16.7,12 22.5,12 C16.7,12 12,7.3 12,1.5 Z M18.5,2 C18.5,4.5 16.5,6.5 14,6.5 C16.5,6.5 18.5,8.5 18.5,11 C18.5,8.5 20.5,6.5 23,6.5 C20.5,6.5 18.5,4.5 18.5,2 Z"
                                       Accent="#38BDF8">
                    <StackPanel Spacing="14">
                    <!-- Master Toggles -->
                    <CheckBox Name="ChkAiFloatingWidget" Content="Show Floating AI Assistant Avatar &amp; Chat Drawer" Foreground="{DynamicResource AppText}"/>
                    <CheckBox Name="ChkAiLoginGreeting" Content="Enable Proactive Voice &amp; Speech Bubble Greetings on Login" Foreground="{DynamicResource AppText}"/>
                    <CheckBox Name="ChkAiSoundChimes" Content="Play Subtle Audio Chimes on AI Responses &amp; Action Proposals" Foreground="{DynamicResource AppText}"/>
                    <!-- Personality & Conversation -->
                    <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="10" Padding="14">
                        <StackPanel Spacing="10">
                            <TextBlock Text="PERSONALITY &amp; CONVERSATION" Foreground="{DynamicResource AppSubtext}" FontSize="11" FontWeight="Bold"/>
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Assistant Name" Foreground="{DynamicResource AppText}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="What the assistant calls itself in conversation." Foreground="{DynamicResource AppMuted}" FontSize="10"/>
                                </StackPanel>
                                <TextBox Grid.Column="1" Name="TxtAiAssistantName" Watermark="Antigravity" Width="170" Background="{DynamicResource AppCard}" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppBorder}" CornerRadius="6" Padding="8,6" FontSize="11"/>
                            </Grid>
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Talkativeness" Foreground="{DynamicResource AppText}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="0 = crisp and terse, 100 = warm and chatty." Foreground="{DynamicResource AppMuted}" FontSize="10"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Slider Name="SldAiTalkativeness" Width="150" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True"/>
                                    <TextBlock Name="TxtAiTalkativenessValue" Text="60" Width="30" FontWeight="Bold" Foreground="{DynamicResource AccentWebsite}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Creativity" Foreground="{DynamicResource AppText}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="How varied the wording is. Lower is more predictable." Foreground="{DynamicResource AppMuted}" FontSize="10"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Slider Name="SldAiCreativity" Width="150" Minimum="0" Maximum="1.5" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                                    <TextBlock Name="TxtAiCreativityValue" Text="0.6" Width="30" FontWeight="Bold" Foreground="{DynamicResource AccentWebsite}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Conversation Memory" Foreground="{DynamicResource AppText}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="How many recent turns the AI remembers, so it can follow up." Foreground="{DynamicResource AppMuted}" FontSize="10"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Slider Name="SldAiMemoryDepth" Width="150" Minimum="0" Maximum="40" TickFrequency="4" IsSnapToTickEnabled="True"/>
                                    <TextBlock Name="TxtAiMemoryDepthValue" Text="12" Width="30" FontWeight="Bold" Foreground="{DynamicResource AccentWebsite}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox Name="ChkAiFollowUpSuggestions" Content="Suggest tappable next questions after each reply" Foreground="{DynamicResource AppText}" Margin="0,4,0,0"/>
                            <CheckBox Name="ChkAiProactiveUpdates" Content="Let the AI proactively message me when something needs attention" Foreground="{DynamicResource AppText}"/>
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Proactive Update Interval" Foreground="{DynamicResource AppText}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="How often the AI checks in on its own. 0 disables it." Foreground="{DynamicResource AppMuted}" FontSize="10"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Slider Name="SldAiProactiveMinutes" Width="150" Minimum="0" Maximum="240" TickFrequency="30" IsSnapToTickEnabled="True"/>
                                    <TextBlock Name="TxtAiProactiveMinutesValue" Text="60" Width="44" FontWeight="Bold" Foreground="{DynamicResource AccentWebsite}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Safety & Privacy -->
                    <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="10" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="SAFETY &amp; PRIVACY" Foreground="{DynamicResource AppSubtext}" FontSize="11" FontWeight="Bold"/>
                            <CheckBox Name="ChkAiRequireApproval" Content="Always require my tap on Approve before any action runs" Foreground="{DynamicResource AppText}"/>
                            <CheckBox Name="ChkAiZeroLeak" Content="Zero-Leak Sanitizer (strips passwords, keys and connection strings)" Foreground="{DynamicResource AppText}" IsChecked="True"/>
                            <CheckBox Name="ChkAiCloudRedact" Content="Redact identifying details before any online (cloud) request" Foreground="{DynamicResource AppText}" IsChecked="True"/>
                            <TextBlock Text="Recommended: keep this ON. Hostnames, IPs, URLs, file paths and computer names are replaced with placeholders before anything leaves this PC. Only aggregate numbers (CPU %, disk free, backup status) are sent."
                                       Foreground="{DynamicResource AppMuted}" FontSize="10" TextWrapping="Wrap" Margin="4,0,0,4"/>
                            <CheckBox Name="ChkAiKeepModelDuringBackups" Content="Keep the local AI model in RAM during backups (faster chat, less free memory)" Foreground="{DynamicResource AppText}"/>
                            <TextBlock Text="Recommended for a 16 GB PC: leave OFF so the model is released automatically before each backup runs."
                                       Foreground="{DynamicResource AppMuted}" FontSize="10" TextWrapping="Wrap" Margin="4,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Name="BtnUnloadAiModel" Content="Free Memory Now" Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppText}" BorderThickness="0" CornerRadius="8" Padding="14,8" FontSize="11" Cursor="Hand"/>
                                <TextBlock Name="TxtAiResourceStatus" Text="" Foreground="{DynamicResource AppSubtext}" FontStyle="Italic" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="AI CPU Threads" Foreground="{DynamicResource AppText}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="Cap on cores the local model may use. 4 keeps backups fast on a 6-core Ryzen 5 5600. 0 = automatic." Foreground="{DynamicResource AppMuted}" FontSize="10"/>
                                </StackPanel>
                                <NumericUpDown Grid.Column="1" Name="NudAiThreads" Minimum="0" Maximum="64" Increment="1" Value="0" Width="90" VerticalAlignment="Center" FormatString="0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <!-- ANCHOR_AI -->
                    <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="AI Intelligence Provider" Foreground="{DynamicResource AppText}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="Select inference engine (Hybrid switches between Ollama, Cloud, and Offline automatically)" Foreground="{DynamicResource AppMuted}" FontSize="10"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Name="CmbAiProvider" Width="220" SelectedIndex="0" VerticalAlignment="Center">
                            <ComboBoxItem Content="Hybrid (Ollama + Cloud + Heuristic)"/>
                            <ComboBoxItem Content="Local Ollama (100% Offline &amp; Private)"/>
                            <ComboBoxItem Content="Cloud LLM (OpenAI / Gemini / Claude)"/>
                            <ComboBoxItem Content="Smart Offline Diagnostics (Zero Setup)"/>
                        </ComboBox>
                    </Grid>

                    <!-- Ollama Configuration Section -->
                    <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,4,0,0">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="LOCAL OLLAMA INFERENCE" Foreground="{DynamicResource AppSubtext}" FontSize="11" FontWeight="Bold"/>
                                <Button Name="BtnTestOllamaConnection" Content="Test Ollama Connection" Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppText}" BorderThickness="0" CornerRadius="6" Padding="10,4" FontSize="10.5" Cursor="Hand"/>
                            </Grid>
                            <Grid ColumnDefinitions="2*, *">
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                    <TextBlock Text="Ollama API Endpoint" Foreground="{DynamicResource AppMuted}" FontSize="10"/>
                                    <TextBox Name="TxtOllamaEndpoint" Watermark="http://127.0.0.1:11434" Background="{DynamicResource AppCard}" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppBorder}" CornerRadius="6" Padding="8,6" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Model Name" Foreground="{DynamicResource AppMuted}" FontSize="10"/>
                                    <TextBox Name="TxtOllamaModel" Watermark="llama3.2:latest" Background="{DynamicResource AppCard}" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppBorder}" CornerRadius="6" Padding="8,6" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Name="TxtOllamaStatus" Text="Ollama status: Not checked" FontSize="10" Foreground="{DynamicResource AppMuted}" FontStyle="Italic"/>
                        </StackPanel>
                    </Border>

                    <!-- Cloud LLM Configuration Section -->
                    <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="10" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="CLOUD LLM INFERENCE (OPTIONAL)" Foreground="{DynamicResource AppSubtext}" FontSize="11" FontWeight="Bold"/>
                            <Grid ColumnDefinitions="*, *">
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                    <TextBlock Text="API Endpoint URL" Foreground="{DynamicResource AppMuted}" FontSize="10"/>
                                    <TextBox Name="TxtCloudEndpoint" Watermark="https://api.openai.com/v1" Background="{DynamicResource AppCard}" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppBorder}" CornerRadius="6" Padding="8,6" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Cloud Model Name" Foreground="{DynamicResource AppMuted}" FontSize="10"/>
                                    <TextBox Name="TxtCloudModel" Watermark="gpt-4o-mini" Background="{DynamicResource AppCard}" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppBorder}" CornerRadius="6" Padding="8,6" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Cloud API Key" Foreground="{DynamicResource AppMuted}" FontSize="10"/>
                                <TextBox Name="TxtCloudApiKey" PasswordChar="*" Watermark="sk-... (Sanitized &amp; encrypted at rest)" Background="{DynamicResource AppCard}" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppBorder}" CornerRadius="6" Padding="8,6" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Action Row -->
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                        <Button Name="BtnSaveAiSettings" Content="Save AI Configuration" Background="{DynamicResource AccentWebsite}" Foreground="{DynamicResource AppText}" BorderThickness="0" CornerRadius="8" Padding="14,8" FontSize="11" Cursor="Hand" FontWeight="Bold"/>
                        <Button Name="BtnResetAiHistory" Content="Reset Chat History" Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppText}" BorderThickness="0" CornerRadius="8" Padding="14,8" FontSize="11" Cursor="Hand"/>
                    </StackPanel>
                    <TextBlock Name="TxtAiStatusMessage" Text="" Foreground="{DynamicResource AppSubtext}" FontStyle="Italic" TextWrapping="Wrap"/>
                    </StackPanel>
            </ui:CollapsibleCardControl>

            <!-- Smart Scheduling, Sync Windows & Bandwidth Guard -->
            <ui:CollapsibleCardControl x:Name="CardSmartScheduling"
                                       Title="Smart Scheduling &amp; Sync Safety"
                                       Subtitle="Free memory before backups, keep services inside their own time window, and pause while your link is busy."
                                       IconData="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,6V11L15,13"
                                       Accent="#34D399">
                <StackPanel Spacing="12">
                    <CheckBox Name="ChkEvictAiBeforeBackup"
                              Content="Release the local AI model from RAM before each scheduled backup"
                              Foreground="{DynamicResource AppText}" IsChecked="True"/>
                    <CheckBox Name="ChkEnableSyncRollback"
                              Content="Keep a copy of remote files before overwriting them, so a sync can be undone"
                              Foreground="{DynamicResource AppText}" IsChecked="True"/>
                    <CheckBox Name="ChkFleetHeartbeat"
                              Content="Alert me when one of my computers goes offline unexpectedly"
                              Foreground="{DynamicResource AppText}" IsChecked="True"/>

                    <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="10" Padding="14">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="Per-Service Sync Windows" Foreground="{DynamicResource AppText}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" Name="ChkSyncWindowsEnabled" IsChecked="False"/>
                            </Grid>
                            <TextBlock Text="Minutes from midnight. Windows crossing midnight are supported. 0 to 1440 means all day."
                                       Foreground="{DynamicResource AppMuted}" FontSize="10" TextWrapping="Wrap"/>

                            <Grid ColumnDefinitions="90, Auto, Auto" Margin="0,2,0,0">
                                <TextBlock Grid.Column="0" Text="Service" Foreground="{DynamicResource AppMuted}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="From" Foreground="{DynamicResource AppMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="To" Foreground="{DynamicResource AppMuted}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid ColumnDefinitions="90, Auto, Auto" Margin="0,2,0,0">
                                <TextBlock Grid.Column="0" Text="Website FTP" Foreground="{DynamicResource AppText}" FontSize="11" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Name="TxtWindowFtpStart" Text="0" Width="62" TextAlignment="Center" Background="{DynamicResource AppCard}" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppBorder}" CornerRadius="6" Padding="6,4" Margin="0,0,6,0" FontSize="11"/>
                                <TextBox Grid.Column="2" Name="TxtWindowFtpEnd" Text="1440" Width="62" TextAlignment="Center" Background="{DynamicResource AppCard}" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppBorder}" CornerRadius="6" Padding="6,4" FontSize="11"/>
                            </Grid>
                            <Grid ColumnDefinitions="90, Auto, Auto" Margin="0,2,0,0">
                                <TextBlock Grid.Column="0" Text="SQL Database" Foreground="{DynamicResource AppText}" FontSize="11" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Name="TxtWindowSqlStart" Text="0" Width="62" TextAlignment="Center" Background="{DynamicResource AppCard}" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppBorder}" CornerRadius="6" Padding="6,4" Margin="0,0,6,0" FontSize="11"/>
                                <TextBox Grid.Column="2" Name="TxtWindowSqlEnd" Text="1440" Width="62" TextAlignment="Center" Background="{DynamicResource AppCard}" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppBorder}" CornerRadius="6" Padding="6,4" FontSize="11"/>
                            </Grid>

                            <Grid ColumnDefinitions="90, Auto, Auto" Margin="0,2,0,0">
                                <TextBlock Grid.Column="0" Text="Mailchimp" Foreground="{DynamicResource AppText}" FontSize="11" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Name="TxtWindowMailStart" Text="0" Width="62" TextAlignment="Center" Background="{DynamicResource AppCard}" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppBorder}" CornerRadius="6" Padding="6,4" Margin="0,0,6,0" FontSize="11"/>
                                <TextBox Grid.Column="2" Name="TxtWindowMailEnd" Text="1440" Width="62" TextAlignment="Center" Background="{DynamicResource AppCard}" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppBorder}" CornerRadius="6" Padding="6,4" FontSize="11"/>
                            </Grid>

                            <TextBlock Name="TxtSyncWindowPreview" Text="" Foreground="{DynamicResource AccentSuccess}" FontSize="10" FontStyle="Italic" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="10" Padding="14">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="Bandwidth-Aware Pausing" Foreground="{DynamicResource AppText}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" Name="ChkBandwidthGuard" IsChecked="False"/>
                            </Grid>
                            <TextBlock Text="Hold scheduled backups while your upload is busy, so gaming and streaming stay smooth."
                                       Foreground="{DynamicResource AppMuted}" FontSize="10" TextWrapping="Wrap"/>
                            <Grid ColumnDefinitions="*, Auto" Margin="0,2,0,0">
                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Busy threshold" Foreground="{DynamicResource AppMuted}" FontSize="10"/>
                                    <TextBlock Name="TxtBandwidthNow" Text="Current upload: --" Foreground="{DynamicResource AppMuted}" FontSize="10"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBox Name="TxtBandwidthThreshold" Text="2000" Width="70" TextAlignment="Center" Background="{DynamicResource AppCard}" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppBorder}" CornerRadius="6" Padding="6,4" FontSize="11"/>
                                    <TextBlock Text="KB/s" Foreground="{DynamicResource AppMuted}" FontSize="10" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                        <Button Name="BtnSaveSmartScheduling" Content="Save Smart Scheduling" Background="{DynamicResource AccentWebsite}" Foreground="{DynamicResource AppText}" BorderThickness="0" CornerRadius="8" Padding="14,8" FontSize="11" Cursor="Hand" FontWeight="Bold"/>
                        <Button Name="BtnPreviewSync" Content="Preview Sync Changes" Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppText}" BorderThickness="0" CornerRadius="8" Padding="14,8" FontSize="11" Cursor="Hand"/>
                    </StackPanel>
                    <TextBlock Name="TxtSmartSchedulingStatus" Text="" Foreground="{DynamicResource AppSubtext}" FontStyle="Italic" TextWrapping="Wrap"/>
                    <TextBlock Name="TxtSyncPreviewResult" Text="" Foreground="{DynamicResource AppText}" FontSize="10.5" TextWrapping="Wrap" MaxHeight="220" IsVisible="False"/>
                </StackPanel>
            </ui:CollapsibleCardControl>

            <!-- My Computers (Wake on LAN & Remote Power) -->
            <ui:CollapsibleCardControl x:Name="CardMyComputers"
                                       Title="My Computers"
                                       Subtitle="Register your Dev PC and Main PC to see live telemetry, wake them over the network, and restart or shut them down remotely."
                                       IconData="M4,5H20V19H4V5M9,19V21H15V19M4,5V3H20V5M20,9H22V11H20M2,9H4V11H2M20,13H22V15H20M2,13H4V15H2"
                                       Accent="#A78BFA">
                <StackPanel Spacing="10">
                    <TextBlock Text="Wake-on-LAN needs a MAC address. Remote restart/shutdown needs the target PC's dashboard URL and matching access PIN."
                           Foreground="{DynamicResource AppMuted}" FontSize="11" TextWrapping="Wrap"/>

                    <!-- Add a new computer -->
                    <Border Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="10" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="ADD A COMPUTER" Foreground="{DynamicResource AppSubtext}" FontSize="11" FontWeight="Bold"/>
                            <Grid ColumnDefinitions="*, *" Margin="0,2,0,0">
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                    <TextBlock Text="Display Name" Foreground="{DynamicResource AppMuted}" FontSize="10"/>
                                    <TextBox Name="TxtNewComputerName" Watermark="Dev PC" Background="{DynamicResource AppCard}" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppBorder}" CornerRadius="6" Padding="8,6" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Role" Foreground="{DynamicResource AppMuted}" FontSize="10"/>
                                    <ComboBox Name="CmbNewComputerRole" HorizontalAlignment="Stretch" SelectedIndex="1">
                                        <ComboBoxItem Content="Main PC"/>
                                        <ComboBoxItem Content="Dev PC"/>
                                        <ComboBoxItem Content="Auxiliary"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*, *" Margin="0,2,0,0">
                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                    <TextBlock Text="MAC Address (for Wake-on-LAN)" Foreground="{DynamicResource AppMuted}" FontSize="10"/>
                                    <TextBox Name="TxtNewComputerMac" Watermark="A4:BB:6D:11:22:33" Background="{DynamicResource AppCard}" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppBorder}" CornerRadius="6" Padding="8,6" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Broadcast Address" Foreground="{DynamicResource AppMuted}" FontSize="10"/>
                                    <TextBox Name="TxtNewComputerBroadcast" Watermark="255.255.255.255" Background="{DynamicResource AppCard}" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppBorder}" CornerRadius="6" Padding="8,6" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Dashboard URL (for remote restart / shutdown)" Foreground="{DynamicResource AppMuted}" FontSize="10"/>
                                <TextBox Name="TxtNewComputerUrl" Watermark="http://192.168.1.20:8080" Background="{DynamicResource AppCard}" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppBorder}" CornerRadius="6" Padding="8,6" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Dashboard Access PIN (stored locally, never sent back out)" Foreground="{DynamicResource AppMuted}" FontSize="10"/>
                                <TextBox Name="TxtNewComputerPin" PasswordChar="*" Watermark="Optional" Background="{DynamicResource AppCard}" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppBorder}" CornerRadius="6" Padding="8,6" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                <Button Name="BtnAddComputer" Content="Add Computer" Background="{DynamicResource AccentWebsite}" Foreground="{DynamicResource AppText}" BorderThickness="0" CornerRadius="8" Padding="14,8" FontSize="11" Cursor="Hand" FontWeight="Bold"/>
                                <Button Name="BtnRefreshComputers" Content="Refresh Telemetry" Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppText}" BorderThickness="0" CornerRadius="8" Padding="14,8" FontSize="11" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Registered computers -->
                    <StackPanel Name="ComputerListPanel" Spacing="8"/>
                    <TextBlock Name="TxtComputerStatus" Text="" Foreground="{DynamicResource AppSubtext}" FontStyle="Italic" TextWrapping="Wrap"/>
                </StackPanel>
            </ui:CollapsibleCardControl>

            <!-- Web Dashboard & Remote Access -->
            <Border Background="{DynamicResource AppCard}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="WEB DASHBOARD &amp; REMOTE ACCESS" FontWeight="Bold" Foreground="{DynamicResource AccentWebsite}" Margin="0,0,0,6"/>
                    <TextBlock Text="Access your backup manager from local web browsers or remotely via Cloudflare Tunnel." Foreground="{DynamicResource AppMuted}" FontSize="11"/>
                    <CheckBox Name="ChkEnableWebDashboard" Content="Enable Built-in Web Dashboard" Foreground="{DynamicResource AppText}"/>
                    <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,8,0,0">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Web Server Port" Foreground="{DynamicResource AppText}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="Local port used by the web dashboard (default 8080)" Foreground="{DynamicResource AppMuted}" FontSize="10"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Name="TxtWebPort" Width="70" TextAlignment="Center" FontSize="13" FontWeight="Bold" Background="{DynamicResource AppSurface}" Foreground="{DynamicResource AccentWebsite}" BorderBrush="{DynamicResource AppBorder}" CornerRadius="6" Padding="8,5" Margin="10,0,6,0"/>
                        <TextBlock Grid.Column="2" Text="port" FontSize="11" Foreground="{DynamicResource AppMuted}" VerticalAlignment="Center"/>
                    </Grid>
                    <CheckBox Name="ChkRequireWebAuth" Content="Require Access PIN for Web Dashboard" Foreground="{DynamicResource AppText}" Margin="0,4,0,0"/>
                    <TextBox Name="TxtWebPin" Watermark="Optional Web Access PIN" Background="{DynamicResource AppSurface}" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppBorder}" CornerRadius="6" Padding="10,6" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                        <Button Name="BtnSaveWebSettings" Content="Save Web Settings" Background="{DynamicResource AccentWebsite}" Foreground="{DynamicResource AppText}" BorderThickness="0" CornerRadius="8" Padding="14,8" FontSize="11" Cursor="Hand" FontWeight="Bold"/>
                        <Button Name="BtnOpenWebDashboard" Content="Open Web Dashboard" Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppText}" BorderThickness="0" CornerRadius="8" Padding="14,8" FontSize="11" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Email & Disconnect Alerts -->
            <Border Background="{DynamicResource AppCard}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="EMAIL &amp; DISCONNECT ALERTS" FontWeight="Bold" Foreground="{DynamicResource AccentWarning}" Margin="0,0,0,6"/>
                    <TextBlock Text="Receive instant email notifications on backup success/failure, outdated backups, or network/tunnel disconnects." Foreground="{DynamicResource AppMuted}" FontSize="11"/>
                    
                    <CheckBox Name="ChkEmailAlertsEnabled" Content="Enable Email Notifications" Foreground="{DynamicResource AppText}"/>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Name="BtnPresetGmail" Content="Gmail Preset" Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppText}" BorderThickness="0" CornerRadius="6" Padding="10,5" FontSize="11" Cursor="Hand"/>
                        <Button Name="BtnPresetOutlook" Content="Outlook Preset" Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppText}" BorderThickness="0" CornerRadius="6" Padding="10,5" FontSize="11" Cursor="Hand"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="2*, *" Margin="0,4,0,0">
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                            <TextBlock Text="SMTP Host" Foreground="{DynamicResource AppSubtext}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBox Name="TxtSmtpHost" Watermark="e.g. smtp.gmail.com" Background="{DynamicResource AppSurface}" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppBorder}" CornerRadius="6" Padding="8,6"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Port" Foreground="{DynamicResource AppSubtext}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBox Name="TxtSmtpPort" Text="587" TextAlignment="Center" Background="{DynamicResource AppSurface}" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppBorder}" CornerRadius="6" Padding="8,6"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox Name="ChkSmtpSsl" Content="Use SSL / TLS (Recommended)" IsChecked="True" Foreground="{DynamicResource AppText}" Margin="0,2,0,0"/>

                    <StackPanel Spacing="4" Margin="0,4,0,0">
                        <TextBlock Text="Sender Email / SMTP Username" Foreground="{DynamicResource AppSubtext}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBox Name="TxtSmtpUser" Watermark="e.g. your-email@gmail.com" Background="{DynamicResource AppSurface}" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppBorder}" CornerRadius="6" Padding="8,6"/>
                    </StackPanel>

                    <StackPanel Spacing="4" Margin="0,4,0,0">
                        <TextBlock Text="SMTP App Password" Foreground="{DynamicResource AppSubtext}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBox Name="TxtSmtpPass" PasswordChar="*" Watermark="App password (generated from Google/Microsoft account)" Background="{DynamicResource AppSurface}" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppBorder}" CornerRadius="6" Padding="8,6"/>
                    </StackPanel>

                    <StackPanel Spacing="4" Margin="0,4,0,0">
                        <TextBlock Text="Recipient Notification Email" Foreground="{DynamicResource AppSubtext}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBox Name="TxtRecipientEmail" Watermark="e.g. alert-receiver@example.com" Background="{DynamicResource AppSurface}" Foreground="{DynamicResource AppText}" BorderBrush="{DynamicResource AppBorder}" CornerRadius="6" Padding="8,6"/>
                    </StackPanel>

                    <StackPanel Spacing="6" Margin="0,6,0,0">
                        <TextBlock Text="NOTIFICATION TRIGGERS" Foreground="{DynamicResource AppSubtext}" FontSize="11" FontWeight="Bold"/>
                        <CheckBox Name="ChkNotifyDisconnect" Content="Alert on Local / Cloudflare Disconnect" IsChecked="True" Foreground="{DynamicResource AppText}"/>
                        <CheckBox Name="ChkNotifyBackupFailure" Content="Alert on Backup Failure" IsChecked="True" Foreground="{DynamicResource AppText}"/>
                        <CheckBox Name="ChkNotifyOutdated" Content="Alert when Backup is Outdated (&gt;24h)" IsChecked="True" Foreground="{DynamicResource AppText}"/>
                        <CheckBox Name="ChkNotifyBackupSuccess" Content="Alert on Backup Success" Foreground="{DynamicResource AppText}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                        <Button Name="BtnSaveEmailSettings" Content="Save Email Settings" Background="{DynamicResource AccentWarning}" Foreground="#000000" BorderThickness="0" CornerRadius="8" Padding="14,8" FontSize="11" Cursor="Hand" FontWeight="Bold"/>
                        <Button Name="BtnSendTestEmail" Content="Send Test Email" Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppText}" BorderThickness="0" CornerRadius="8" Padding="14,8" FontSize="11" Cursor="Hand"/>
                    </StackPanel>
                    <TextBlock Name="TxtEmailStatus" Text="" Foreground="{DynamicResource AppSubtext}" FontStyle="Italic" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- System Information (4th) -->
            <Border Background="{DynamicResource AppCard}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="SYSTEM INFORMATION" FontWeight="Bold" Foreground="{DynamicResource AccentWebsite}" Margin="0,0,0,10"/>
                    <Grid ColumnDefinitions="Auto, *">
                        <TextBlock Text="App Version:" Foreground="{DynamicResource AppSubtext}" Width="120"/>
                        <TextBlock Grid.Column="1" Name="TxtVersion" Text="v..." FontWeight="Bold"/>
                    </Grid>
                    <Grid ColumnDefinitions="Auto, *">
                        <TextBlock Text="Created By:" Foreground="{DynamicResource AppSubtext}" Width="120"/>
                        <TextBlock Grid.Column="1" Name="TxtCreator" Text="Wesley" FontWeight="Bold"/>
                    </Grid>
                    <Button Name="BtnShowSystemInfo" Content="VIEW CHANGELOG &amp; BUILD INFO" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" 
                            Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppText}" FontWeight="Bold" Padding="10" CornerRadius="8" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Credentials & Paths (3rd) -->
            <Border Background="{DynamicResource AppCard}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="15">
                    <TextBlock Text="CONFIGURATION" FontWeight="Bold" Foreground="{DynamicResource AccentWebsite}" Margin="0,0,0,10"/>
                    
                    <Grid ColumnDefinitions="*,*,*">
                        <Button Name="BtnEditCredentials" Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppText}" Padding="15,12" CornerRadius="8" HorizontalAlignment="Stretch" Margin="0,0,5,0">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <PathIcon Data="M12,17A2,2 0 0,1 14,19A2,2 0 0,1 12,21A2,2 0 0,1 10,19A2,2 0 0,1 12,17M12,4C14.5,4 16.5,5.5 17.3,8H17.3C17.5,8.5 18,9 18.6,9H19C20.1,9 21,9.9 21,11C21,12.1 20.1,13 19,13H17.3C17.3,13.2 17.2,13.5 17.1,13.7L15.7,15.8C15.4,16.2 15,16.4 14.5,16.4H9.5C9,16.4 8.6,16.2 8.3,15.8L6.9,13.7C6.8,13.5 6.7,13.2 6.7,13H5C3.9,13 3,12.1 3,11C3,9.9 3.9,9 5,9H5.4C6,9 6.5,8.5 6.7,8H6.7C7.5,5.5 9.5,4 12,4Z" Width="20" Height="20"/>
                                <TextBlock Text="Edit Credentials" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Name="BtnEditPaths" Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppText}" Padding="15,12" CornerRadius="8" HorizontalAlignment="Stretch" Grid.Column="1" Margin="5,0,5,0">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <PathIcon Data="M20,18H4V8H20M20,6H12L10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6Z" Width="20" Height="20"/>
                                <TextBlock Text="Edit Paths" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Name="BtnEditNetworkDrive" Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppText}" Padding="15,12" CornerRadius="8" HorizontalAlignment="Stretch" Grid.Column="2" Margin="5,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <PathIcon Data="M15,20A1,1 0 0,0 16,19V4A1,1 0 0,0 15,3H4A1,1 0 0,0 3,4V19A1,1 0 0,0 4,20H15M4,2H15A2,2 0 0,1 17,4V19A2,2 0 0,1 15,21H4A2,2 0 0,1 2,19V4A2,2 0 0,1 4,2M22,18H19V20H22V18M22,10H19V16H22V10M22,6H19V8H22V6Z" Width="20" Height="20"/>
                                <TextBlock Text="Network Drive" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    
                    <TextBlock Name="TxtConfigStatus" Text="" Foreground="{DynamicResource AppSubtext}" FontStyle="Italic" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Management Tools -->
            <Border Background="{DynamicResource AppCard}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="15">
                    <TextBlock Text="MANAGEMENT TOOLS" FontWeight="Bold" Foreground="{DynamicResource AccentSql}" Margin="0,0,0,10"/>
                    
                    <Button Name="BtnResetAllUsers" Content="Reset All Users (Local + Firebase)" Background="{DynamicResource AppBtnRed}" Foreground="{DynamicResource AccentError}" BorderThickness="0" CornerRadius="8" Padding="14,8" FontSize="11" HorizontalAlignment="Stretch" Cursor="Hand"/>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Border>
</UserControl>
