<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PinayPalBackupManager.UI.UserControls.ThemeCustomizerDialog"
             MaxWidth="600" MaxHeight="580"
             MinWidth="360" MinHeight="420"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <Border Background="{DynamicResource AppCard}" CornerRadius="16" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Padding="24">
        <Grid RowDefinitions="Auto, *, Auto">

            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="CUSTOMIZE THEME" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppText}"/>
                    <TextBlock Text="Change colors, fonts, and preview your changes" FontSize="11" Foreground="{DynamicResource AppMuted}"/>
                </StackPanel>
                <Button Grid.Column="1" Name="BtnClose" Content="&#x2715;" Background="Transparent" Foreground="{DynamicResource AppMuted}"
                        BorderThickness="0" FontSize="16" Padding="8,4" Cursor="Hand" VerticalAlignment="Top"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                <StackPanel Spacing="20">

                    <!-- Preset Palettes -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="PRESET PALETTES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppMuted}" LetterSpacing="1"/>
                        <WrapPanel Name="PresetPanel">
                            <!-- Generated in code-behind -->
                        </WrapPanel>
                    </StackPanel>

                    <!-- Color Inputs -->
                    <StackPanel Spacing="12">
                        <TextBlock Text="COLORS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppMuted}" LetterSpacing="1"/>

                        <Grid ColumnDefinitions="120, *, Auto" RowDefinitions="Auto, Auto, Auto, Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Primary" VerticalAlignment="Center" Foreground="{DynamicResource AppSubtext}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Name="TxtPrimary" Watermark="#52B788" Margin="0,0,8,0"/>
                            <Border Grid.Row="0" Grid.Column="2" Name="SwatchPrimary" Width="28" Height="28" CornerRadius="6" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Secondary" VerticalAlignment="Center" Foreground="{DynamicResource AppSubtext}" Margin="0,8,0,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Name="TxtSecondary" Watermark="#00b4d8" Margin="0,8,8,0"/>
                            <Border Grid.Row="1" Grid.Column="2" Name="SwatchSecondary" Width="28" Height="28" CornerRadius="6" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Margin="0,8,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Error" VerticalAlignment="Center" Foreground="{DynamicResource AppSubtext}" Margin="0,8,0,0"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Name="TxtError" Watermark="#F38BA8" Margin="0,8,8,0"/>
                            <Border Grid.Row="2" Grid.Column="2" Name="SwatchError" Width="28" Height="28" CornerRadius="6" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Margin="0,8,0,0"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Success" VerticalAlignment="Center" Foreground="{DynamicResource AppSubtext}" Margin="0,8,0,0"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Name="TxtSuccess" Watermark="#A6E3A1" Margin="0,8,8,0"/>
                            <Border Grid.Row="3" Grid.Column="2" Name="SwatchSuccess" Width="28" Height="28" CornerRadius="6" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" Margin="0,8,0,0"/>
                        </Grid>
                    </StackPanel>

                    <!-- Font Settings -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="FONT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppMuted}" LetterSpacing="1"/>
                        <Grid ColumnDefinitions="120, *">
                            <TextBlock Grid.Column="0" Text="Family" VerticalAlignment="Center" Foreground="{DynamicResource AppSubtext}"/>
                            <TextBox Grid.Column="1" Name="TxtFontFamily" Watermark="Segoe UI"/>
                        </Grid>
                        <Grid ColumnDefinitions="120, *">
                            <TextBlock Grid.Column="0" Text="Size" VerticalAlignment="Center" Foreground="{DynamicResource AppSubtext}"/>
                            <Slider Grid.Column="1" Name="SliderFontSize" Minimum="10" Maximum="20" Value="14" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        </Grid>
                        <TextBlock Name="LblFontSize" Text="14 px" FontSize="10" Foreground="{DynamicResource AppMuted}" HorizontalAlignment="Right"/>
                    </StackPanel>

                    <!-- Preview -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="PREVIEW" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AppMuted}" LetterSpacing="1"/>
                        <Border Name="PreviewCard" Background="{DynamicResource AppSurface}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Name="PreviewTitle" Text="Sample Title" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Name="PreviewBody" Text="This is how your text will look with the selected font and colors." FontSize="12" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Name="PreviewBtn" Content="Primary" Background="{DynamicResource AccentWebsite}" Foreground="#000000" BorderThickness="0" CornerRadius="8" Padding="12,6" FontWeight="SemiBold"/>
                                    <Button Content="Secondary" Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppText}" BorderThickness="0" CornerRadius="8" Padding="12,6"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer Buttons -->
            <Grid Grid.Row="2" ColumnDefinitions="*, Auto, Auto, Auto" Margin="0,16,0,0">
                <Button Grid.Column="0" Name="BtnReset" Content="Reset to Default" Classes="Ghost" Padding="12,8" FontSize="11"/>
                <Button Grid.Column="1" Name="BtnCancel" Content="Cancel" Background="{DynamicResource AppSurface}" Foreground="{DynamicResource AppText}" BorderThickness="0" CornerRadius="8" Padding="16,8" FontSize="11" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Name="BtnApply" Content="Apply" Background="{DynamicResource AccentWebsite}" Foreground="#000000" BorderThickness="0" CornerRadius="8" Padding="20,8" FontSize="11" FontWeight="SemiBold"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
