<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PinayPalBackupManager.UI.UserControls.BackupHistoryControl">
    <Border Background="#0D1117" CornerRadius="12" Padding="0">
        <StackPanel Spacing="0">
            <!-- Header with Close Button -->
            <Grid Background="#161B22" Height="50" ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" Text="BACKUP HISTORY" FontWeight="Bold" Foreground="{DynamicResource AccentFtp}" FontSize="14" VerticalAlignment="Center" Margin="20,0"/>
                <Button Name="BtnClose" Grid.Column="1" Content="✕" Classes="Ghost" Width="40" Height="40" Margin="10" FontSize="18" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </Grid>

            <!-- Content -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="20" Margin="20">
                    <!-- Header -->
                    <Border Background="#161B22" CornerRadius="12" Padding="20">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Spacing="5">
                                <TextBlock Name="TxtSummary" Text="Loading..." Foreground="#8B949E" FontSize="12"/>
                            </StackPanel>
                            <Button Name="BtnRefresh" Grid.Column="1" Classes="Secondary" Content="Refresh" Margin="10,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Filters -->
                    <Border Background="#161B22" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="15">
                            <TextBlock Text="FILTERS" FontWeight="Bold" Foreground="{DynamicResource AppText}" FontSize="12"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Service:" VerticalAlignment="Center"/>
                                <ComboBox Name="CmbService" Width="100" SelectedIndex="0">
                                    <ComboBoxItem Content="All"/>
                                    <ComboBoxItem Content="FTP"/>
                                    <ComboBoxItem Content="SQL"/>
                                    <ComboBoxItem Content="Mailchimp"/>
                                </ComboBox>
                                <TextBlock Text="Status:" VerticalAlignment="Center"/>
                                <ComboBox Name="CmbStatus" Width="120" SelectedIndex="0">
                                    <ComboBoxItem Content="All"/>
                                    <ComboBoxItem Content="Success"/>
                                    <ComboBoxItem Content="Failed"/>
                                    <ComboBoxItem Content="Cancelled"/>
                                </ComboBox>
                                <Button Name="BtnApplyFilter" Classes="Secondary" Content="Apply"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Backup List -->
                    <Border Background="#161B22" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="15">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="BACKUP ENTRIES" FontWeight="Bold" Foreground="{DynamicResource AppText}" FontSize="12"/>
                                <Button Name="BtnClearHistory" Grid.Column="1" Classes="Secondary" Content="Clear Old (90 days)" Margin="10,0,0,0" FontSize="11"/>
                            </Grid>
                            <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                                <StackPanel Name="BackupList" Spacing="10"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Actions -->
                    <Grid ColumnDefinitions="*, *" Margin="0,0,0,20">
                        <Button Name="BtnExport" Classes="Secondary" Content="Export Report" HorizontalAlignment="Stretch" Margin="0,0,5,0"/>
                        <Button Name="BtnViewDetails" Classes="Primary" Grid.Column="1" Content="View Summary" HorizontalAlignment="Stretch" Margin="5,0,0,0"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </Border>
</UserControl>
