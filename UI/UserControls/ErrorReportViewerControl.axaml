<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PinayPalBackupManager.UI.UserControls.ErrorReportViewerControl">
    <Border Background="{DynamicResource AppCard}" CornerRadius="12" Padding="0">
        <Grid RowDefinitions="Auto, *">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="20">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="ERROR REPORTS" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppText}"/>
                    <TextBlock Text="View and export error logs" FontSize="12" Foreground="{DynamicResource AppMuted}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Name="BtnRefresh" Content="Refresh" Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppSubtext}"
                            BorderThickness="0" CornerRadius="8" Padding="16,8" FontSize="12" Cursor="Hand"/>
                    <Button Name="BtnExport" Content="Export" Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppSubtext}"
                            BorderThickness="0" CornerRadius="8" Padding="16,8" FontSize="12" Cursor="Hand"/>
                    <Button Name="BtnClearAll" Content="Clear All" Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppSubtext}"
                            BorderThickness="0" CornerRadius="8" Padding="16,8" FontSize="12" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="20" Margin="20">
                    <!-- Summary -->
                    <Border Background="{DynamicResource AppSurface}" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="5">
                            <TextBlock Name="TxtSummary" Text="Loading..." Foreground="{DynamicResource AppMuted}" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Filters -->
                    <Border Background="{DynamicResource AppSurface}" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="15">
                            <TextBlock Text="FILTERS" FontWeight="Bold" Foreground="{DynamicResource AppText}" FontSize="12"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Filter:" VerticalAlignment="Center"/>
                                <ComboBox Name="CmbFilterType" Width="120" SelectedIndex="0">
                                    <ComboBoxItem Content="All Errors"/>
                                    <ComboBoxItem Content="Critical Only"/>
                                    <ComboBoxItem Content="By Source"/>
                                </ComboBox>
                                <TextBox Name="TxtFilterSource" Width="150" Watermark="Source name" IsVisible="False"/>
                                <Button Name="BtnApplyFilter" Classes="Secondary" Content="Apply"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Error List -->
                    <Border Background="{DynamicResource AppSurface}" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="15">
                            <TextBlock Text="ERROR LIST" FontWeight="Bold" Foreground="{DynamicResource AppText}" FontSize="12"/>
                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                <StackPanel Name="ErrorList" Spacing="10"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Error Details -->
                    <Border Name="BorderErrorDetails" Background="{DynamicResource AppSurface}" CornerRadius="12" Padding="20" IsVisible="False">
                        <StackPanel Spacing="15">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="ERROR DETAILS" FontWeight="Bold" Foreground="{DynamicResource AppText}" FontSize="12"/>
                                <Button Name="BtnCloseDetails" Grid.Column="1" Classes="Ghost" Content="✕" Width="30" Height="30" FontSize="16" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                            </Grid>
                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                <StackPanel Name="ErrorDetailsPanel" Spacing="10"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <StackPanel Height="20"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
