<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:uc="clr-namespace:PinayPalBackupManager.UI.UserControls"
        x:Class="PinayPalBackupManager.UI.MainWindow"
        Title="PinayPal Backup Manager"
        Width="1320" Height="860"
        MinWidth="1080" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBg}"
        Foreground="{DynamicResource AppText}"
        Icon="/Assets/logo.ico">
    
    <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, *, 40">
        <!-- Sidebar -->
        <Border Name="SidebarBorder" Grid.Column="0" Grid.RowSpan="2" Background="{DynamicResource AppSidebar}"
                BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,1,0"
                HorizontalAlignment="Left" Width="210" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect OffsetX="8" OffsetY="0" BlurRadius="40" Opacity="0.2"/>
            </Border.Effect>
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.25" Easing="CubicEaseInOut"/>
                </Transitions>
            </Border.Transitions>
            <Grid RowDefinitions="Auto, *, Auto, Auto">

                <!-- Logo Area -->
                <Border Grid.Row="0" Padding="0,24,0,20" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AppBorder}"
                        Background="{DynamicResource AppSidebar}">
                    <StackPanel HorizontalAlignment="Center" Spacing="10">
                        <Image Source="/Assets/logo.ico" Width="40" Height="40" HorizontalAlignment="Center"/>
                        <TextBlock Name="LogoText" Text="PinayPal Backup Manager" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentWebsite}" HorizontalAlignment="Center"
                                   LetterSpacing="2" Opacity="1">
                            <TextBlock.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                </Transitions>
                            </TextBlock.Transitions>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Navigation Buttons -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Name="Sidebar" Spacing="1" Margin="10,10,10,6" VerticalAlignment="Top">

                    <!-- Section: Main -->
                    <TextBlock Text="MAIN" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppMuted}"
                               Margin="12,0,0,4" LetterSpacing="1.5"/>
                    <Button Classes="SideBtn" Tag="Home" ToolTip.Tip="Dashboard">
                        <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource HomeIcon}" Width="18" Height="18" Foreground="{DynamicResource SidebarIconMuted}"/>
                            <TextBlock Text="Dashboard" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Section: Backup Services -->
                    <TextBlock Text="BACKUP" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppMuted}"
                               Margin="12,7,0,4" LetterSpacing="1.5"/>
                    <Button Classes="SideBtn MainTab" Tag="FTP" ToolTip.Tip="Website / FTP Backup">
                        <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource CloudIcon}" Width="18" Height="18" Foreground="{DynamicResource SidebarIconMuted}"/>
                            <TextBlock Text="Website Backup" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="SideBtn MainTab" Tag="Mailchimp" ToolTip.Tip="Mailchimp Backup">
                        <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource MailIcon}" Width="18" Height="18" Foreground="{DynamicResource SidebarIconMuted}"/>
                            <TextBlock Text="Mailchimp" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="SideBtn MainTab" Tag="SQL" ToolTip.Tip="SQL Backup">
                        <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource DatabaseIcon}" Width="18" Height="18" Foreground="{DynamicResource SidebarIconMuted}"/>
                            <TextBlock Text="SQL Backup" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Section: Monitoring -->
                    <TextBlock Text="MONITORING" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppMuted}"
                               Margin="12,7,0,4" LetterSpacing="1.5"/>
                    <Button Classes="SideBtn" Tag="Verification" ToolTip.Tip="Backup Verification">
                        <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                            <PathIcon Data="M9,12L11,14L15,10M21,12C21,16.97 16.97,21 12,21C7.03,21 3,16.97 3,12C3,7.03 7.03,3 12,3C16.97,3 21,7.03 21,12M12,5C8.13,5 5,8.13 5,12C5,15.87 8.13,19 12,19C15.87,19 19,15.87 19,12C19,8.13 15.87,5 12,5Z" Width="18" Height="18" Foreground="{DynamicResource SidebarIconMuted}"/>
                            <TextBlock Text="Verification" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="SideBtn" Tag="Statistics" ToolTip.Tip="Statistics">
                        <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                            <PathIcon Data="M22,21H2V3H4V19H6V10H10V19H12V6H16V19H18V14H22V21Z" Width="18" Height="18" Foreground="{DynamicResource SidebarIconMuted}"/>
                            <TextBlock Text="Statistics" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="SideBtn" Tag="HealthCheck" ToolTip.Tip="Health Check">
                        <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                            <PathIcon Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M10,17L6,13L7.41,11.59L10,14.17L16.59,7.58L18,9L10,17" Width="18" Height="18" Foreground="{DynamicResource SidebarIconMuted}"/>
                            <TextBlock Text="Health Check" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="SideBtn" Tag="ErrorReports" ToolTip.Tip="Error Reports">
                        <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                            <PathIcon Data="M1,21H23L12,2L1,21M13,18H11V16H13V18M13,14H11V10H13V14" Width="18" Height="18" Foreground="{DynamicResource SidebarIconMuted}"/>
                            <TextBlock Text="Error Reports" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="SideBtn" Tag="PerformanceMetrics" ToolTip.Tip="Performance Metrics">
                        <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                            <PathIcon Data="M3.5,18.5L9.5,12.5L13.5,16.5L22,7L20.59,5.59L13.5,13.5L9.5,9.5L2,17L3.5,18.5" Width="18" Height="18" Foreground="{DynamicResource SidebarIconMuted}"/>
                            <TextBlock Text="Performance" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>

                    <!-- Section: History & Config -->
                    <TextBlock Text="HISTORY" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppMuted}"
                               Margin="12,7,0,4" LetterSpacing="1.5"/>
                    <Button Classes="SideBtn" Tag="BackupHistory" ToolTip.Tip="Backup History">
                        <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                            <PathIcon Data="M13,3A9,9 0 0,0 4,12H1L4.89,15.89L4.96,16.03L9,12H6A7,7 0 0,1 13,5A7,7 0 0,1 20,12A7,7 0 0,1 13,19C11.07,19 9.32,18.21 8.06,16.94L6.64,18.36C8.27,19.99 10.51,21 13,21A9,9 0 0,0 22,12A9,9 0 0,0 13,3M14,8H12V13L16.28,15.54L17,14.33L13.5,12.25V8" Width="18" Height="18" Foreground="{DynamicResource SidebarIconMuted}"/>
                            <TextBlock Text="Backup History" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="SideBtn" Tag="BackupSchedule" ToolTip.Tip="Backup Schedule">
                        <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                            <PathIcon Data="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.9 20.1,3 19,3H18V1M17,13H12V18H17V13" Width="18" Height="18" Foreground="{DynamicResource SidebarIconMuted}"/>
                            <TextBlock Text="Schedule" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>

                    <!-- Section: Config -->
                    <TextBlock Text="CONFIG" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AppMuted}"
                               Margin="12,7,0,4" LetterSpacing="1.5"/>
                    <Button Classes="SideBtn" Tag="Settings" ToolTip.Tip="Settings">
                        <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource SettingsIcon}" Width="18" Height="18" Foreground="{DynamicResource SidebarIconMuted}"/>
                            <TextBlock Text="Settings" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Name="BtnUserManagement" Classes="SideBtn" Tag="UserManagement" ToolTip.Tip="User Management" IsVisible="False">
                        <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                            <PathIcon Data="M12,16A4,4 0 0,1 16,12A4,4 0 0,1 12,8A4,4 0 0,1 8,12A4,4 0 0,1 12,16M12,18C6.5,18 2,15.3 2,12C2,8.7 6.5,6 12,6C17.5,6 22,8.7 22,12C22,15.3 17.5,18 12,18Z" Width="18" Height="18" Foreground="{DynamicResource SidebarIconMuted}"/>
                            <TextBlock Text="Users" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
                </ScrollViewer>

                <!-- Customize Tabs Button -->
                <Button Name="BtnCustomizeTabs" Grid.Row="2" Classes="SideBtn" ToolTip.Tip="Customize Tab Order"
                        Margin="10,4,10,4" Cursor="Hand"                        BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                        <PathIcon Data="M3,15H21V13H3V15M3,19H21V17H3V19M3,11H21V9H3V11M3,5V7H21V5H3Z"
                                  Width="18" Height="18" Foreground="{DynamicResource SidebarIconMuted}"/>
                        <TextBlock Text="Customize" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Profile Section -->
                <Border Grid.Row="3" Padding="8,10,8,12"
                        BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,1,0,0">
                    <Button Name="BtnProfile" Classes="SideBtn" ToolTip.Tip="Profile" Padding="8,0">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Grid Width="32" Height="32">
                                <Ellipse Name="AvatarImageBg" Width="32" Height="32" Fill="{DynamicResource AppSurface}"/>
                                <Ellipse Width="32" Height="32" Stroke="{DynamicResource AppBorder}" StrokeThickness="1.5"/>
                                <Image Name="AvatarImage" Width="32" Height="32" Stretch="UniformToFill" IsVisible="False">
                                    <Image.Clip>
                                        <EllipseGeometry Rect="0,0,32,32"/>
                                    </Image.Clip>
                                </Image>
                            </Grid>
                            <StackPanel Name="ProfileTextPanel" VerticalAlignment="Center" Spacing="1" Opacity="1">
                                <StackPanel.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                    </Transitions>
                                </StackPanel.Transitions>
                                <TextBlock Text="Profile" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppText}"/>
                                <TextBlock Text="Account Settings" FontSize="10" Foreground="{DynamicResource AppMuted}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </Border>

            </Grid>
        </Border>

        <!-- Sidebar Collapse/Expand Toggle (outside sidebar to avoid clipping) -->
        <Button Name="SidebarToggle" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Width="30" Height="30" Margin="0,0,-14,0"
                Background="{DynamicResource AppCard}"
                BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                CornerRadius="15" Padding="0"
                ZIndex="1000" Cursor="Hand" ToolTip.Tip="Collapse sidebar">
            <Button.Effect>
                <DropShadowEffect OffsetX="2" OffsetY="2" BlurRadius="8" Opacity="0.4"/>
            </Button.Effect>
            <PathIcon Name="SidebarToggleIcon"
                      Data="M15.41,7.41L14,6L8,12L14,18L15.41,16.59L10.83,12L15.41,7.41Z"
                      Width="14" Height="14" Foreground="{DynamicResource AppSubtext}"/>
        </Button>

        <!-- Top Bar with Modern Elevation -->
        <Border Name="TopBarBorder" Grid.Row="0" Grid.Column="1" Height="64"
                Background="{DynamicResource AppTopBar}"
                BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,0,1"
                BoxShadow="0 4 24 #00000020">
            <Grid ColumnDefinitions="Auto, *, Auto" Margin="20,0,20,0">

                <!-- US Time Badge -->
                <Border Grid.Column="0" Background="{DynamicResource AppSurface}"
                        CornerRadius="12" Padding="14,8" VerticalAlignment="Center"
                        BoxShadow="0 1 4 #00000010">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"
                                  Width="11" Height="11" Foreground="{DynamicResource AppMuted}"/>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="US  UTC-7" Foreground="{DynamicResource AppMuted}" FontSize="8" FontWeight="Bold" LetterSpacing="0.5"/>
                            <TextBlock Name="TxtUsTime" Text="--:--:--" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppText}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Manila Time Badge -->
                <Border Grid.Column="1"
                        Background="{DynamicResource AppBtnGreen}"
                        BorderBrush="{DynamicResource AccentFtpGlow}" BorderThickness="1"
                        CornerRadius="12" Padding="14,8" Margin="12,0"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BoxShadow="0 1 6 #34D39920">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentFtp}"/>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="MANILA  UTC+8" Foreground="{DynamicResource AccentFtp}" FontSize="8" FontWeight="Bold" LetterSpacing="0.5"/>
                            <TextBlock Name="TxtMnlTime" Text="--:--:--" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentFtp}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Right: Bell + Connection + Version -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" Margin="0,0,0,0">
                    <!-- Bell with badge -->
                    <Grid>
                        <Button Name="BtnNotificationCenter" Background="{DynamicResource AppSurface}"
                                BorderThickness="0" ToolTip.Tip="Notifications" Cursor="Hand"
                                CornerRadius="12" Padding="10,9">
                            <PathIcon Data="M21,19V20H3V19L5,17V11C5,7.9 7.03,5.17 10,4.29V4A2,2 0 0,1 12,2A2,2 0 0,1 14,4V4.29C16.97,5.17 19,7.9 19,11V17L21,19M14,21A2,2 0 0,1 12,23A2,2 0 0,1 10,21"
                                      Width="14" Height="14" Foreground="{DynamicResource AppSubtext}"/>
                        </Button>
                        <Border Name="BellBadge" Background="{DynamicResource AccentError}"
                                CornerRadius="6" Padding="3,1"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                IsVisible="False" Margin="0,0,2,0">
                            <TextBlock Name="BellCount" Text="0" FontSize="8" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </Grid>

                    <!-- Theme Toggle -->
                    <Button Name="BtnThemeToggle" Background="{DynamicResource AppSurface}"
                            BorderThickness="0" ToolTip.Tip="Toggle Dark/Light Theme" Cursor="Hand"
                            CornerRadius="12" Padding="10,9">
                        <PathIcon Name="ThemeIcon" Data="M9,2C7.95,2.64 7,3.5 6.24,4.54C4.96,6.35 4.2,8.53 4.2,10.89C4.2,16.42 8.68,20.89 14.2,20.89C16.57,20.89 18.74,20.13 20.55,18.85C19.87,19.05 19.16,19.16 18.42,19.16C13.35,19.16 9.24,15.05 9.24,9.97C9.24,6.63 11.14,3.76 13.99,2.18C12.42,2.06 10.75,2.33 9,2Z"
                                  Width="14" Height="14" Foreground="{DynamicResource AppSubtext}"/>
                    </Button>

                    <!-- Connection Status -->
                    <Border Name="ConnectionStatus" Background="{DynamicResource AppSurface}"
                            BorderThickness="0" CornerRadius="12" Padding="12,9"
                            ToolTip.Tip="Firebase Connection Status"
                            BoxShadow="0 1 3 #0000000A">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Name="ConnectionDot" Width="7" Height="7" Fill="{DynamicResource AccentFtp}" VerticalAlignment="Center"/>
                            <TextBlock Name="ConnectionText" Text="Online" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppSubtext}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Version -->
                    <Border Background="{DynamicResource AppSurface}" BorderThickness="0" CornerRadius="12" Padding="12,9"
                            BoxShadow="0 1 3 #0000000A">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Name="BtnSystemInfo" Background="Transparent" BorderThickness="0"
                                    VerticalAlignment="Center" Cursor="Hand" Padding="0">
                                <PathIcon Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z"
                                          Width="12" Height="12" Foreground="{DynamicResource AppMuted}"/>
                            </Button>
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="VERSION" Foreground="{DynamicResource AppMuted}" FontSize="8" FontWeight="Bold" LetterSpacing="0.5"/>
                                <TextBlock Name="TxtVersionBadge" Text="v2.19.0" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppText}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Offline Banner with Modern Styling -->
        <Border Name="OfflineBanner" Grid.Row="0" Grid.Column="1"
                Background="{DynamicResource AccentErrorBg}" BorderBrush="{DynamicResource AccentError}" BorderThickness="0,0,0,2"
                IsVisible="False" VerticalAlignment="Bottom" Margin="0,0,0,-38"
                Padding="12,10" ZIndex="20" CornerRadius="0"
                BoxShadow="0 4 16 #FB718520">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                <PathIcon Data="M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M13,17H11V15H13V17M13,13H11V7H13V13Z"
                          Width="16" Height="16" Foreground="{DynamicResource AccentError}" VerticalAlignment="Center"/>
                <TextBlock Text="No internet connection. Remote backup tabs are disabled."
                           Foreground="{DynamicResource AccentError}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" LetterSpacing="0.3"/>
            </StackPanel>
        </Border>

        <!-- Content Container with Modern Spacing -->
        <ContentControl Grid.Row="1" Grid.Column="1" Name="MainContent" Margin="28,28,28,0"/>

        <!-- Notification Center Overlay (for click-outside-to-close) -->
        <Border Name="NotificationOverlay" Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" IsVisible="False"
                Background="#00000000" ZIndex="997" 
                PointerPressed="NotificationOverlay_PointerPressed"/>
                
        <!-- Notification Center Flyout -->
        <Border Name="NotificationCenter" Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" IsVisible="False"
                ZIndex="998" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,58,16,0" Width="340"
                Background="{DynamicResource AppCard}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="16"
                MaxHeight="450" Opacity="0.98"
                BoxShadow="0 8 32 #00000040, 0 2 8 #00000020">
                <Grid RowDefinitions="Auto, *">
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="16,14,16,10">
                        <TextBlock Text="NOTIFICATIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppSubtext}" LetterSpacing="0.5" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Name="BtnClearNotifications" Content="Clear all" Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AppMuted}" BorderThickness="0" CornerRadius="6" Padding="8,4" FontSize="10" Cursor="Hand"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="True" Padding="0,0,0,8">
                        <StackPanel Name="NotificationList" Spacing="2" Margin="8,0,8,8"/>
                    </ScrollViewer>
                </Grid>
            </Border>

        <!-- Bottom Status Bar with Modern Elevation -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Name="StatusBar" Height="40"
                Background="{DynamicResource AppSidebar}"
                BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,1,0,0"
                BoxShadow="0 -2 12 #00000015">
            <Grid ColumnDefinitions="*, Auto" Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <PathIcon Name="StatusIcon" Data="{StaticResource CloudIcon}" Width="14" Height="14" Foreground="{DynamicResource AppMuted}"/>
                    <TextBlock Name="TxtStatus" Text="SYSTEM READY" VerticalAlignment="Center"
                               FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppSubtext}" LetterSpacing="0.5"/>
                </StackPanel>
                <Border Grid.Column="1" Name="HealthBadge"
                        Background="{DynamicResource AppBtnGreen}" BorderBrush="{DynamicResource AccentFtpGlow}" BorderThickness="1"
                        CornerRadius="10" Margin="0,6,0,6" Padding="14,6"
                        BoxShadow="0 2 8 #34D39920">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Name="HealthIndicator" Width="8" Height="8" Fill="{DynamicResource AccentFtp}"/>
                        <TextBlock Name="TxtHealth" Text="ALL SYSTEMS OK" VerticalAlignment="Center"
                                   FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentFtp}" LetterSpacing="0.5"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>


        <Border Name="StartupOverlay" Grid.RowSpan="3" Grid.ColumnSpan="2" IsVisible="False" Background="#AA000000" Padding="0" ZIndex="999" Opacity="0.98">
                <Grid>
                    <Border BorderBrush="{DynamicResource AccentWebsite}" BorderThickness="1" CornerRadius="16"
                            Width="400" HorizontalAlignment="Center" VerticalAlignment="Center"
                            ClipToBounds="True" Background="{DynamicResource AppCard}">
                        <StackPanel>
                            <!-- Branded header -->
                            <Border Background="{DynamicResource AppSidebar}" Padding="24,18" CornerRadius="15,15,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
                                    <Image Source="/Assets/logo.ico" Width="36" Height="36" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="PinayPal Backup Manager" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentWebsite}"/>
                                        <TextBlock Text="Initializing services..." FontSize="11" Foreground="{DynamicResource AppSubtext}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Content -->
                            <StackPanel Spacing="14" Margin="28,22,28,26">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="Running health scan" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppText}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Checking all services before starting..." FontSize="11" Foreground="{DynamicResource AppMuted}" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <ProgressBar IsIndeterminate="True" Height="6" CornerRadius="3" Background="{DynamicResource AppBorder}" Foreground="{DynamicResource AccentWebsite}"/>
                                <TextBlock Name="TxtStartupHint" Text="Please wait" FontSize="11" Foreground="{DynamicResource AppMuted}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
    </Grid>

    <Window.Styles>
        <!-- Sidebar Text Opacity Transitions -->
        <Style Selector="StackPanel#Sidebar > TextBlock">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.SideBtn StackPanel > TextBlock">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Sidebar Button Animations -->
        <Style Selector="Button.SideBtn">
            <Setter Property="Height" Value="38"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.22" Easing="SineEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="SineEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.SideBtn">
            <Setter Property="Padding" Value="12,0"/>
        </Style>
        <Style Selector="Button.SideBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource SidebarHover}"/>
            <Setter Property="RenderTransform" Value="scale(1.04) translateY(-1px)"/>
        </Style>
        <Style Selector="Button.SideBtn.Selected">
            <Setter Property="Background" Value="{DynamicResource SidebarSelectedBg}"/>
        </Style>
        <Style Selector="Button.SideBtn:pressed">
            <Setter Property="Background" Value="{DynamicResource AppCard}"/>
            <Setter Property="RenderTransform" Value="scale(0.96)"/>
        </Style>

        <!-- Sidebar Button Icons -->
        <Style Selector="Button.SideBtn PathIcon">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.22" Easing="SineEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.SideBtn:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentMailchimp}"/>
        </Style>
        <Style Selector="Button.SideBtn.Selected PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentMailchimp}"/>
        </Style>
        <Style Selector="Button.SideBtn.Selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentMailchimp}"/>
        </Style>

        <!-- Main Backup Tab highlight: colored icon + bold label only -->
        <Style Selector="Button.SideBtn.MainTab PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentFtp}"/>
        </Style>
        <Style Selector="Button.SideBtn.MainTab TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Profile Menu Styles -->
        <Style Selector="Button.ProfileMenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="#6C7086"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" 
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ContentPresenter Content="{TemplateBinding Tag}" Margin="0,0,4,0"/>
                            <ContentPresenter Content="{TemplateBinding Content}"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.ProfileMenuItem:pointerover">
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
        </Style>
        <Style Selector="Button.ProfileMenuItem:pressed">
            <Setter Property="Background" Value="#6C7086"/>
        </Style>
        <Style Selector="Button.LogoutBtn">
            <Setter Property="Foreground" Value="#F38BA8"/>
        </Style>
        <Style Selector="Button.LogoutBtn:pointerover">
            <Setter Property="Background" Value="#F38BA8"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
        </Style>

        <!-- Content Control Fade-in Animation -->
        <Style Selector="ContentControl">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.4"/>
                </Transitions>
            </Setter>
        </Style>


        <!-- Border Hover Effects -->
        <Style Selector="Border">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.25"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.25"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Glass Effect for Cards -->
        <Style Selector="Border.background-card">
            <Setter Property="Opacity" Value="0.95"/>
            <Setter Property="Effect">
                <DropShadowEffect OffsetX="0" OffsetY="2" BlurRadius="15" Opacity="0.08"/>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.25"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Status Bar Animation -->
        <Style Selector="Border#StatusBar">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Health Indicator Pulse Animation -->
        <Style Selector="Ellipse#HealthIndicator">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:0.5"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.5"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Profile Control Button Styles -->
        <Style Selector="Button.PrimaryBtn">
            <Setter Property="Background" Value="#00b4d8"/>
            <Setter Property="Foreground" Value="#0B0F17"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.25"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.PrimaryBtn:pointerover">
            <Setter Property="Background" Value="#0096c7"/>
        </Style>
        <Style Selector="Button.PrimaryBtn:pressed">
            <Setter Property="Background" Value="#0077b6"/>
        </Style>

        <Style Selector="Button.SecondaryBtn">
            <Setter Property="Background" Value="#6C7086"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#6C7086"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.25"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.25"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.SecondaryBtn:pointerover">
            <Setter Property="Background" Value="#6C7086"/>
            <Setter Property="BorderBrush" Value="#6C7086"/>
        </Style>
        <Style Selector="Button.SecondaryBtn:pressed">
            <Setter Property="Background" Value="#6C7086"/>
        </Style>

        <Style Selector="Button.DangerBtn">
            <Setter Property="Background" Value="#F38BA8"/>
            <Setter Property="Foreground" Value="#0B0F17"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.25"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.DangerBtn:pointerover">
            <Setter Property="Background" Value="#E5748E"/>
        </Style>
        <Style Selector="Button.DangerBtn:pressed">
            <Setter Property="Background" Value="#D95A76"/>
        </Style>
    </Window.Styles>

    <Window.Resources>
        <StreamGeometry x:Key="HomeIcon">M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z</StreamGeometry>
        <StreamGeometry x:Key="CloudIcon">M6,20C3.24,20 1,17.76 1,15C1,12.56 2.78,10.53 5.12,10.12C6.04,7.18 8.77,5 12,5C15.4,5 18.25,7.44 18.88,10.68C21.22,10.9 23,12.85 23,15.25C23,17.87 20.87,20 18.25,20H6M12,7C9.5,7 7.4,8.5 6.4,10.7L6.1,11.3L5.4,11.3C3.9,11.5 2.8,12.7 2.8,14.2C2.8,15.8 4.1,17.2 5.7,17.2H17.2C18.8,17.2 20.2,15.8 20.2,14.2C20.2,12.6 18.8,11.2 17.2,11.2H16.2L16,10.2C15.5,8.1 13.7,6.6 11.5,6.6L12,7Z</StreamGeometry>
        <StreamGeometry x:Key="MailIcon">M20,4H4C2.9,4 2,4.9 2,6V18C2,19.1 2.9,20 4,20H20C21.1,20 22,19.1 22,18V6C22,4.9 21.1,4 20,4M20,18H4V8L12,13L20,8V18M12,11L4,6H20L12,11Z</StreamGeometry>
        <StreamGeometry x:Key="DatabaseIcon">M12,3C7.58,3 4,4.79 4,7C4,9.21 7.58,11 12,11C16.42,11 20,9.21 20,7C20,4.79 16.42,3 12,3M4,9V12C4,14.21 7.58,16 12,16C16.42,16 20,14.21 20,12V9C20,11.21 16.42,13 12,13C7.58,13 4,11.21 4,9M4,14V17C4,19.21 7.58,21 12,21C16.42,21 20,19.21 20,17V14C20,16.21 16.42,18 12,18C7.58,18 4,16.21 4,14Z</StreamGeometry>
        <StreamGeometry x:Key="SettingsIcon">M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11.03L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.22,8.95 2.27,9.22 2.46,9.37L4.57,11.03C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.22,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.95C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.95L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z</StreamGeometry>
    </Window.Resources>
</Window>
