<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PinayPalBackupManager.UI.LoginWindow"
        Title="PinayPal Backup Manager — Login"
        Width="460" Height="600"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="{DynamicResource AppBg}"
        Foreground="{DynamicResource AppText}"
        Icon="avares://PinayPalBackupManager/Assets/logo.ico">

    <!-- Root: centered card on dark canvas -->
    <Grid>
        <!-- Background subtle radial glow -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="600" Height="600" Opacity="0.07">
            <Border.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#9D7FFF" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Card -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="400"
                Background="{DynamicResource AppCard}"
                BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect OffsetX="0" OffsetY="12" BlurRadius="48" Opacity="0.35"/>
            </Border.Effect>

            <Grid RowDefinitions="Auto, *">

                <!-- Branded header with gradient -->
                <Border Grid.Row="0" CornerRadius="20,20,0,0" Padding="32,28,32,22">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#120D2A" Offset="0"/>
                            <GradientStop Color="#0E1525" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <Image Source="/Assets/logo.ico" Width="44" Height="44" HorizontalAlignment="Center"/>
                        <TextBlock Text="PinayPal Backup" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentWebsite}" HorizontalAlignment="Center" LetterSpacing="0.3"/>
                        <TextBlock Name="TxtSubtitle" Text="Sign in to your account"
                                   FontSize="12" Foreground="{DynamicResource AppMuted}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Panels container -->
                <Grid Grid.Row="1">

                    <!-- Login Panel -->
                    <Border Name="LoginPanel" IsVisible="True" Padding="32,24,32,28">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Username" Foreground="{DynamicResource AppSubtext}" FontSize="11" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBox Name="TxtLoginUser" Watermark="Enter your username"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Password" Foreground="{DynamicResource AppSubtext}" FontSize="11" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBox Name="TxtLoginPass" Watermark="Enter your password" PasswordChar="●"/>
                            </StackPanel>

                            <TextBlock Name="TxtLoginError" Text="" Foreground="{DynamicResource AccentError}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,-4,0,0"/>

                            <Button Name="BtnLogin" Content="SIGN IN"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Background="{DynamicResource AccentWebsite}"
                                    Foreground="#FFFFFF" FontWeight="Bold"
                                    FontSize="13" Padding="14" CornerRadius="10"
                                    Margin="0,4,0,0"/>

                            <Grid ColumnDefinitions="*,Auto" Margin="0,-4,0,0">
                                <CheckBox Name="ChkRememberMe" Content="Stay signed in" Classes="Modern"
                                          Foreground="{DynamicResource AppMuted}" FontSize="11" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Name="BtnForgotUser" Content="Forgot user?" Classes="Link"
                                            Foreground="{DynamicResource AppMuted}" FontSize="11"
                                            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"/>
                                    <TextBlock Text="•" Foreground="{DynamicResource AppBorder}" FontSize="11" VerticalAlignment="Center"/>
                                    <Button Name="BtnForgotPass" Content="Forgot password?" Classes="Link"
                                            Foreground="{DynamicResource AccentWebsite}" FontSize="11"
                                            Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                            FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>

                            <!-- Divider -->
                            <Rectangle Height="1" Fill="{DynamicResource AppBorder}" Margin="0,2"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="Don't have an account?" Foreground="{DynamicResource AppMuted}" FontSize="11"/>
                                <Button Name="BtnShowRegister" Content="Register here" Classes="Link"
                                        Foreground="{DynamicResource AccentWebsite}" FontSize="11"
                                        Background="Transparent" BorderThickness="0" Padding="2,0" Cursor="Hand"
                                        FontWeight="SemiBold"/>
                            </StackPanel>

                            <Button Name="BtnEmergencyAdmin" Content="Create Emergency Admin Account"
                                    HorizontalAlignment="Center"
                                    Background="Transparent" Foreground="{DynamicResource AccentError}"
                                    BorderThickness="0" Padding="6,4" FontSize="11"
                                    Cursor="Hand" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- 2FA Panel -->
                    <Border Name="TwoFactorPanel" IsVisible="False" Padding="32,24,32,28">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="4">
                                <TextBlock Text="TWO-FACTOR AUTH" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentFtp}" FontSize="13" LetterSpacing="0.5"/>
                                <TextBlock Text="Enter the 6-digit code from your authenticator app"
                                           Foreground="{DynamicResource AppMuted}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>

                            <TextBox Name="Txt2FACode" Watermark="000000" FontSize="22"
                                     HorizontalContentAlignment="Center" Padding="12,14" LetterSpacing="6"/>

                            <CheckBox Name="ChkRememberDevice" Content="Remember this device for 30 days" Classes="Modern"
                                      Foreground="{DynamicResource AppMuted}" FontSize="11"
                                      HorizontalAlignment="Center"/>

                            <TextBlock Name="Txt2FAError" Text="" Foreground="{DynamicResource AccentError}"
                                       FontSize="10" TextWrapping="Wrap"/>
                            <TextBlock Text="Lost your phone? Use a recovery code instead"
                                       Foreground="{DynamicResource AppMuted}" FontSize="10" TextWrapping="Wrap"/>

                            <Button Name="BtnVerify2FA" Content="VERIFY CODE"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Background="{DynamicResource AccentFtp}" Foreground="#000000"
                                    FontWeight="Bold" Padding="14" CornerRadius="10"/>

                            <Button Name="BtnBackToLogin" Content="← Back to Login"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Background="{DynamicResource AppSurface}" Foreground="{DynamicResource AppText}"
                                    FontWeight="SemiBold" Padding="12" CornerRadius="10" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <!-- Register Panel -->
                    <Border Name="RegisterPanel" IsVisible="False" Padding="32,24,32,28">
                        <StackPanel Spacing="13">
                            <TextBlock Name="TxtRegTitle" Text="Create Account" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentWebsite}" FontSize="16" Margin="0,0,0,4"/>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Username" Foreground="{DynamicResource AppSubtext}" FontSize="11" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBox Name="TxtRegUser" Watermark="Choose a username"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Password" Foreground="{DynamicResource AppSubtext}" FontSize="11" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBox Name="TxtRegPass" Watermark="Choose a password" PasswordChar="●"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Email Address (for recovery)" Foreground="{DynamicResource AppSubtext}" FontSize="11" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBox Name="TxtRegEmail" Watermark="you@example.com"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Birthday (YYYY-MM-DD)" Foreground="{DynamicResource AppSubtext}" FontSize="11" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBox Name="TxtRegBirthDate" Watermark="YYYY-MM-DD (e.g. 1990-05-15)"/>
                            </StackPanel>

                            <StackPanel Name="InviteCodePanel" Spacing="6">
                                <TextBlock Text="Invite Code" Foreground="{DynamicResource AppSubtext}" FontSize="11" FontWeight="SemiBold" LetterSpacing="0.5"/>
                                <TextBox Name="TxtInviteCode" Watermark="Enter invite code from admin"/>
                            </StackPanel>

                            <TextBlock Name="TxtRegError" Text="" Foreground="{DynamicResource AccentError}"
                                       FontSize="11" TextWrapping="Wrap"/>

                            <Button Name="BtnRegister" Content="CREATE ACCOUNT"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Background="{DynamicResource AccentWebsite}" Foreground="#FFFFFF"
                                    FontWeight="Bold" FontSize="13" Padding="14" CornerRadius="10" Margin="0,4,0,0"/>

                            <Rectangle Height="1" Fill="{DynamicResource AppBorder}" Margin="0,2"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="Already have an account?" Foreground="{DynamicResource AppMuted}" FontSize="11"/>
                                <Button Name="BtnShowLogin" Content="Sign in" Classes="Link"
                                        Foreground="{DynamicResource AccentFtp}" FontSize="11"
                                        Background="Transparent" BorderThickness="0" Padding="2,0"
                                        Cursor="Hand" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Recovery Panel (Forgot Username & Password OTP) -->
                    <Border Name="RecoveryPanel" IsVisible="False" Padding="28,18,28,22">
                        <StackPanel Spacing="11">
                            <!-- Segmented Mode Header -->
                            <Border Background="{DynamicResource AppSurface}" CornerRadius="10" Padding="4">
                                <Grid ColumnDefinitions="*,*">
                                    <Button Name="BtnTabForgotUser" Content="Forgot Username"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Padding="8,6" CornerRadius="8" FontSize="11" FontWeight="Bold"
                                            Background="Transparent" Foreground="{DynamicResource AppMuted}" Cursor="Hand"/>
                                    <Button Grid.Column="1" Name="BtnTabForgotPass" Content="Forgot Password"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            Padding="8,6" CornerRadius="8" FontSize="11" FontWeight="Bold"
                                            Background="{DynamicResource AccentWebsite}" Foreground="#FFFFFF" Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <!-- Sub-Panel 1: Forgot Username -->
                            <StackPanel Name="SubPanelForgotUser" Spacing="10" IsVisible="False">
                                <TextBlock Text="Enter your registered email address and birthday to verify and receive your username."
                                           Foreground="{DynamicResource AppMuted}" FontSize="11" TextWrapping="Wrap"/>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Email Address" Foreground="{DynamicResource AppSubtext}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBox Name="TxtForgotEmail" Watermark="you@example.com"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Birthday (Verification)" Foreground="{DynamicResource AppSubtext}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBox Name="TxtForgotBirthDate" Watermark="YYYY-MM-DD (e.g. 1990-05-15)"/>
                                </StackPanel>
                                <Button Name="BtnSendUsername" Content="VERIFY &amp; SEND USERNAME"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Background="{DynamicResource AccentWebsite}" Foreground="#FFFFFF"
                                        FontWeight="Bold" FontSize="12" Padding="12" CornerRadius="10" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Sub-Panel 2: Forgot Password - Step 1: Request OTP -->
                            <StackPanel Name="SubPanelPassStep1" Spacing="10" IsVisible="True">
                                <TextBlock Text="Enter your username or email address to receive a 6-digit verification code."
                                           Foreground="{DynamicResource AppMuted}" FontSize="11" TextWrapping="Wrap"/>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Username or Email" Foreground="{DynamicResource AppSubtext}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBox Name="TxtPassResetIdentifier" Watermark="Enter username or email"/>
                                </StackPanel>
                                <!-- Optional email field if account has no email yet -->
                                <StackPanel Name="PnlOverrideEmail" Spacing="4" IsVisible="False">
                                    <TextBlock Text="Recovery Email (No email on account yet)" Foreground="{DynamicResource AccentWebsite}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBox Name="TxtOverrideEmail" Watermark="Enter email to receive OTP"/>
                                </StackPanel>
                                <Button Name="BtnRequestOtp" Content="SEND 6-DIGIT OTP CODE"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Background="{DynamicResource AccentWebsite}" Foreground="#FFFFFF"
                                        FontWeight="Bold" FontSize="12" Padding="12" CornerRadius="10" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Sub-Panel 2: Forgot Password - Step 2: Verify OTP -->
                            <StackPanel Name="SubPanelPassStep2" Spacing="10" IsVisible="False">
                                <TextBlock Name="TxtOtpSentNotice" Text="Enter the 6-digit verification code sent to your email."
                                           Foreground="{DynamicResource AppMuted}" FontSize="11" TextWrapping="Wrap"/>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="6-Digit Verification Code" Foreground="{DynamicResource AppSubtext}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBox Name="TxtOtpInput" Watermark="000000" FontSize="20" HorizontalContentAlignment="Center"
                                             LetterSpacing="6" MaxLength="6"/>
                                </StackPanel>
                                <Button Name="BtnVerifyOtp" Content="VERIFY OTP CODE"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Background="{DynamicResource AccentWebsite}" Foreground="#FFFFFF"
                                        FontWeight="Bold" FontSize="12" Padding="12" CornerRadius="10" Margin="0,4,0,0"/>
                                <Button Name="BtnResendOtp" Content="Resend Verification Code" Classes="Link"
                                        HorizontalAlignment="Center" Foreground="{DynamicResource AccentWebsite}"
                                        FontSize="11" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>

                            <!-- Sub-Panel 2: Forgot Password - Step 3: New Password -->
                            <StackPanel Name="SubPanelPassStep3" Spacing="10" IsVisible="False">
                                <TextBlock Text="Create a secure new password for your account."
                                           Foreground="{DynamicResource AppMuted}" FontSize="11" TextWrapping="Wrap"/>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="New Password" Foreground="{DynamicResource AppSubtext}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBox Name="TxtNewPassword" Watermark="Enter new password" PasswordChar="●"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Confirm New Password" Foreground="{DynamicResource AppSubtext}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBox Name="TxtConfirmNewPassword" Watermark="Re-enter new password" PasswordChar="●"/>
                                </StackPanel>
                                <Button Name="BtnSaveNewPassword" Content="RESET PASSWORD &amp; SIGN IN"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Background="{DynamicResource AccentWebsite}" Foreground="#FFFFFF"
                                        FontWeight="Bold" FontSize="12" Padding="12" CornerRadius="10" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Recovery Status / Error Text -->
                            <TextBlock Name="TxtRecoveryStatus" Text="" Foreground="{DynamicResource AccentError}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>

                            <!-- Divider -->
                            <Rectangle Height="1" Fill="{DynamicResource AppBorder}" Margin="0,2"/>

                            <!-- Back to Login Button -->
                            <Button Name="BtnBackFromRecovery" Content="← Back to Sign In" Classes="Link"
                                    HorizontalAlignment="Center" Foreground="{DynamicResource AppMuted}"
                                    FontSize="11" Background="Transparent" BorderThickness="0"
                                    Padding="4" Cursor="Hand" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource AppSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentWebsite}"/>
        </Style>
        <Style Selector="TextBox:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AppMuted}"/>
        </Style>
        <Style Selector="Button.Link">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.Link:pointerover">
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <Style Selector="Button#BtnLogin, Button#BtnRegister, Button#BtnVerify2FA">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button#BtnLogin:pointerover, Button#BtnRegister:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentWebsiteLight}"/>
            <Setter Property="RenderTransform" Value="translateY(-1px)"/>
        </Style>
        <Style Selector="Button#BtnLogin:pressed, Button#BtnRegister:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

        <!-- Modern CheckBox Style -->
        <Style Selector="CheckBox.Modern">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,0,0,0"/>
        </Style>
        <Style Selector="CheckBox.Modern /template/ Border#NormalRectangle">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="Background" Value="{DynamicResource AppSurface}"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
        </Style>
        <Style Selector="CheckBox.Modern:checked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="{DynamicResource AccentWebsite}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentWebsite}"/>
        </Style>
        <Style Selector="CheckBox.Modern:pointerover /template/ Border#NormalRectangle">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentWebsite}"/>
        </Style>
        <Style Selector="CheckBox.Modern /template/ Path#CheckMark">
            <Setter Property="Stroke" Value="#FFFFFF"/>
            <Setter Property="StrokeThickness" Value="2"/>
        </Style>
        <Style Selector="CheckBox.Modern:checked > ContentPresenter">
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource AppText}"/>
        </Style>
    </Window.Styles>
</Window>
